<!-- Highlight & Share: select text on a blog post to share it on social media -->
<div class="highlight-share" id="highlight-share-tooltip" role="tooltip" aria-hidden="true">
  <button data-platform="twitter" aria-label="Compartir selección en Twitter">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
      <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
    </svg>
  </button>
  <button data-platform="facebook" aria-label="Compartir selección en Facebook">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
      <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
    </svg>
  </button>
  <button data-platform="linkedin" aria-label="Compartir selección en LinkedIn">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
      <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
    </svg>
  </button>
</div>

<style>
  .highlight-share {
    position: fixed;
    display: none;
    align-items: center;
    gap: 2px;
    padding: 4px;
    background-color: var(--color-bg-dark);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xl);
    z-index: 9999;
    transform: translateX(-50%);
    animation: fadeIn 0.15s ease;
  }

  .highlight-share.is-visible {
    display: flex;
  }

  .highlight-share button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border: none;
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--color-text-on-dark-muted);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .highlight-share button:hover {
    background-color: rgba(255, 255, 255, 0.1);
    color: var(--color-text-on-dark);
  }

  .highlight-share button[data-platform='twitter']:hover {
    color: #1da1f2;
  }

  .highlight-share button[data-platform='facebook']:hover {
    color: #1877f2;
  }

  .highlight-share button[data-platform='linkedin']:hover {
    color: #0a66c2;
  }
</style>

<script>
  const tooltip = document.getElementById('highlight-share-tooltip');
  const articleContent = document.getElementById('article-content');

  if (tooltip && articleContent) {
    let selectedText = '';

    articleContent.addEventListener('mouseup', (e) => {
      const selection = window.getSelection();
      const text = selection?.toString().trim();

      if (text && text.length > 10) {
        selectedText = text;
        const range = selection!.getRangeAt(0);
        const rect = range.getBoundingClientRect();

        tooltip.style.top = `${rect.top + window.scrollY - 48}px`;
        tooltip.style.left = `${rect.left + rect.width / 2}px`;
        tooltip.classList.add('is-visible');
        tooltip.setAttribute('aria-hidden', 'false');
      } else {
        hideTooltip();
      }
    });

    document.addEventListener('mousedown', (e) => {
      if (!tooltip.contains(e.target as Node)) {
        hideTooltip();
      }
    });

    tooltip.querySelectorAll('button').forEach((btn) => {
      btn.addEventListener('click', () => {
        const platform = btn.getAttribute('data-platform');
        const url = window.location.href;
        const encoded = encodeURIComponent(`"${selectedText}"`);
        const encodedUrl = encodeURIComponent(url);

        let shareUrl = '';
        switch (platform) {
          case 'twitter':
            shareUrl = `https://twitter.com/intent/tweet?text=${encoded}&url=${encodedUrl}`;
            break;
          case 'facebook':
            shareUrl = `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}&quote=${encoded}`;
            break;
          case 'linkedin':
            shareUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`;
            break;
        }

        if (shareUrl) {
          window.open(shareUrl, '_blank', 'width=600,height=400');
        }

        hideTooltip();
      });
    });

    function hideTooltip() {
      tooltip.classList.remove('is-visible');
      tooltip.setAttribute('aria-hidden', 'true');
    }
  }
</script>
