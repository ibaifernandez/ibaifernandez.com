---
const currentPath = Astro.url.pathname;

const escrituraLinks = [
  { href: '/articulos',             label: 'Todos los artículos' },
  { href: '/el-oficio-de-escritor', label: 'El oficio de escritor' },
  { href: '/no-somos-heroes',       label: 'No somos héroes' },
  { href: '/filosofia-rebelde',     label: 'Filosofía Rebelde' },
  { href: '/poesia',                label: 'Poesía' },
  { href: '/libros',                label: 'Libros' },
];
---

<header class="header" id="main-header">
  <div class="header__inner container">

    <a href="/" class="header__logo" aria-label="Ibai Fernández — Inicio">
      <img
        src="/images/branding/260213-ibai-fernandez-visual-id-2026-03.svg"
        alt="Ibai Fernández"
        class="header__logo-img"
        width="120"
        height="50"
      />
    </a>

    <!-- Desktop nav -->
    <nav class="header__nav" id="main-nav" aria-label="Navegación principal">
      <ul class="header__nav-list">

        <!-- Escritura dropdown -->
        <li class="header__nav-item header__nav-item--has-dropdown">
          <button
            class:list={['header__nav-link', {
              active: currentPath.startsWith('/articulos') ||
                      currentPath.startsWith('/el-oficio') ||
                      currentPath.startsWith('/no-somos') ||
                      currentPath.startsWith('/filosofia-rebelde') ||
                      currentPath.startsWith('/poesia') ||
                      currentPath.startsWith('/libros') ||
                      currentPath.startsWith('/blog')
            }]}
            aria-haspopup="true"
            aria-expanded="false"
            id="dropdown-escritura-btn"
          >
            Escritura
            <svg class="header__chevron" width="10" height="6" viewBox="0 0 10 6" fill="none">
              <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <div class="header__dropdown" id="dropdown-escritura" role="menu" aria-labelledby="dropdown-escritura-btn">
            {escrituraLinks.map((link) => (
              <a
                href={link.href}
                class:list={['header__dropdown-link', { active: currentPath === link.href }]}
                role="menuitem"
              >
                {link.label}
              </a>
            ))}
          </div>
        </li>

        <li class="header__nav-item">
          <a
            href="/fotografia"
            class:list={['header__nav-link', { active: currentPath.startsWith('/fotografia') || currentPath.startsWith('/new-york') || currentPath.startsWith('/dublin') || currentPath.startsWith('/movimiento-15-m') || currentPath.startsWith('/nobiemvre') }]}
          >
            Fotografía
          </a>
        </li>

        <li class="header__nav-item">
          <a
            href="/cine"
            class:list={['header__nav-link', { active: currentPath.startsWith('/cine') || currentPath.startsWith('/the-if-show') || currentPath.startsWith('/noche-sin-manana') }]}
          >
            Cine
          </a>
        </li>

        <li class="header__nav-item">
          <a href="/hablemos" class="btn btn--primary btn--sm header__cta">
            Hablemos →
          </a>
        </li>

      </ul>
    </nav>

    <!-- Mobile toggle -->
    <button
      class="header__menu-toggle"
      id="menu-toggle"
      aria-label="Abrir menú"
      aria-expanded="false"
    >
      <span class="header__menu-icon"></span>
    </button>

  </div>
</header>

<!-- Mobile overlay nav -->
<div class="header__mobile-overlay" id="mobile-overlay" aria-hidden="true">
  <nav aria-label="Menú móvil">
    <ul class="header__mobile-list">
      <li>
        <span class="header__mobile-section">Escritura</span>
        <ul class="header__mobile-sub">
          {escrituraLinks.map((link) => (
            <li><a href={link.href} class="header__mobile-link">{link.label}</a></li>
          ))}
        </ul>
      </li>
      <li><a href="/fotografia" class="header__mobile-link header__mobile-link--main">Fotografía</a></li>
      <li><a href="/cine"       class="header__mobile-link header__mobile-link--main">Cine</a></li>
      <li><a href="/hablemos"   class="header__mobile-link header__mobile-link--cta">Hablemos →</a></li>
    </ul>
  </nav>
</div>

<style>
  /* ---- Header shell ---- */
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    height: var(--header-height);
    background-color: rgba(14, 12, 10, 0.88);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    transition: background-color var(--transition-base);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
  }

  /* ---- Logo ---- */
  .header__logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
    transition: opacity var(--transition-fast);
  }

  .header__logo:hover {
    opacity: 0.75;
  }

  .header__logo-img {
    height: 40px;
    width: auto;
    display: block;
  }

  /* ---- Desktop nav ---- */
  .header__nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .header__nav-item {
    position: relative;
  }

  .header__nav-link {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-on-dark-muted);
    text-decoration: none;
    letter-spacing: 0.02em;
    padding: var(--space-2) 0;
    position: relative;
    transition: color var(--transition-fast);
    background: none;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .header__nav-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 1px;
    background-color: var(--blood);
    transition: width var(--transition-base);
  }

  .header__nav-link:hover,
  .header__nav-link.active {
    color: var(--text-on-dark);
  }

  .header__nav-link:hover::after,
  .header__nav-link.active::after {
    width: 100%;
  }

  .header__chevron {
    transition: transform var(--transition-base);
    flex-shrink: 0;
  }

  .header__nav-item--has-dropdown:hover .header__chevron,
  .header__nav-item--has-dropdown[data-open] .header__chevron {
    transform: rotate(180deg);
  }

  /* ---- Dropdown ---- */
  .header__dropdown {
    position: absolute;
    top: calc(100% + var(--space-3));
    left: 50%;
    transform: translateX(-50%);
    background-color: var(--ink-soft);
    border: 1px solid var(--ink-muted);
    padding: var(--space-2) 0;
    min-width: 220px;
    opacity: 0;
    visibility: hidden;
    transform: translateX(-50%) translateY(-8px);
    transition:
      opacity var(--transition-base),
      transform var(--transition-base),
      visibility var(--transition-base);
    z-index: 100;
  }

  .header__nav-item--has-dropdown:hover .header__dropdown,
  .header__nav-item--has-dropdown[data-open] .header__dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }

  .header__dropdown-link {
    display: block;
    padding: var(--space-3) var(--space-6);
    font-size: var(--text-sm);
    color: var(--text-on-dark-muted);
    text-decoration: none;
    transition: color var(--transition-fast), background var(--transition-fast);
    white-space: nowrap;
  }

  .header__dropdown-link:hover,
  .header__dropdown-link.active {
    color: var(--text-on-dark);
    background-color: rgba(155, 32, 32, 0.12);
  }

  /* ---- CTA button ---- */
  .header__cta {
    letter-spacing: 0.06em;
    background-color: transparent;
    border-color: rgba(240, 235, 227, 0.35);
    color: var(--text-on-dark) !important;
  }

  .header__cta:hover {
    background-color: var(--blood);
    border-color: var(--blood);
    color: var(--cream) !important;
  }

  /* ---- Mobile toggle ---- */
  .header__menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 40px;
    height: 40px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    z-index: 1002;
  }

  .header__menu-icon,
  .header__menu-icon::before,
  .header__menu-icon::after {
    display: block;
    width: 22px;
    height: 1.5px;
    background-color: var(--text-on-dark);
    transition: all var(--transition-base);
  }

  .header__menu-icon::before,
  .header__menu-icon::after {
    content: '';
    position: relative;
  }

  .header__menu-icon::before { top: -7px; }
  .header__menu-icon::after  { top: 5px; }

  .header__menu-toggle[aria-expanded='true'] .header__menu-icon {
    background-color: transparent;
  }

  .header__menu-toggle[aria-expanded='true'] .header__menu-icon::before {
    top: 0;
    transform: rotate(45deg);
  }

  .header__menu-toggle[aria-expanded='true'] .header__menu-icon::after {
    top: -2px;
    transform: rotate(-45deg);
  }

  /* ---- Mobile overlay ---- */
  .header__mobile-overlay {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 999;
    background-color: var(--ink);
    padding: calc(var(--header-height) + var(--space-8)) var(--space-6) var(--space-8);
    overflow-y: auto;
    transform: translateX(100%);
    transition: transform var(--transition-slow);
  }

  .header__mobile-overlay.is-open {
    transform: translateX(0);
  }

  .header__mobile-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .header__mobile-section {
    display: block;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--blood);
    margin-bottom: var(--space-3);
  }

  .header__mobile-sub {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .header__mobile-link {
    display: block;
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-style: italic;
    color: var(--text-on-dark-muted);
    text-decoration: none;
    padding: var(--space-2) 0;
    transition: color var(--transition-fast);
  }

  .header__mobile-link:hover {
    color: var(--text-on-dark);
  }

  .header__mobile-link--main {
    font-size: var(--text-3xl);
    font-style: italic;
    color: var(--text-on-dark);
    padding: var(--space-3) 0;
    border-top: 1px solid var(--ink-muted);
  }

  .header__mobile-link--cta {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-style: normal;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--blood-light);
    padding: var(--space-4) 0;
    border-top: 1px solid var(--ink-muted);
  }

  /* ---- Responsive breakpoint ---- */
  @media (max-width: 768px) {
    .header__nav { display: none; }

    .header__menu-toggle { display: flex; }

    .header__mobile-overlay { display: block; }
  }
</style>

<script>
  const toggle      = document.getElementById('menu-toggle');
  const overlay     = document.getElementById('mobile-overlay');
  const dropdownBtn = document.getElementById('dropdown-escritura-btn');
  const dropdownEl  = document.getElementById('dropdown-escritura');
  const dropdownParent = dropdownBtn?.closest('.header__nav-item');

  // ---- Mobile menu ----
  if (toggle && overlay) {
    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!isOpen));
      toggle.setAttribute('aria-label', isOpen ? 'Abrir menú' : 'Cerrar menú');
      overlay.classList.toggle('is-open', !isOpen);
      overlay.setAttribute('aria-hidden', String(isOpen));
      document.body.style.overflow = isOpen ? '' : 'hidden';
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        toggle.setAttribute('aria-expanded', 'false');
        overlay.classList.remove('is-open');
        overlay.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }
    });
  }

  // ---- Desktop dropdown (keyboard + click) ----
  if (dropdownBtn && dropdownEl && dropdownParent) {
    dropdownBtn.addEventListener('click', () => {
      const isOpen = dropdownParent.hasAttribute('data-open');
      if (isOpen) {
        dropdownParent.removeAttribute('data-open');
        dropdownBtn.setAttribute('aria-expanded', 'false');
      } else {
        dropdownParent.setAttribute('data-open', '');
        dropdownBtn.setAttribute('aria-expanded', 'true');
      }
    });

    // Close on outside click
    document.addEventListener('click', (e) => {
      if (!dropdownParent.contains(e.target as Node)) {
        dropdownParent.removeAttribute('data-open');
        dropdownBtn.setAttribute('aria-expanded', 'false');
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        dropdownParent.removeAttribute('data-open');
        dropdownBtn.setAttribute('aria-expanded', 'false');
      }
    });
  }

  // ---- Scroll: slightly more opaque on scroll ----
  const header = document.getElementById('main-header');
  if (header) {
    window.addEventListener('scroll', () => {
      header.style.backgroundColor = window.scrollY > 40
        ? 'rgba(14, 12, 10, 0.96)'
        : 'rgba(14, 12, 10, 0.88)';
    }, { passive: true });
  }
</script>
