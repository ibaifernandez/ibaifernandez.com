---
interface Props {
  title: string;
  url:   string;
}

const { title, url } = Astro.props;

const enc  = (s: string) => encodeURIComponent(s);

const platforms = [
  {
    label: 'X',
    href:  `https://twitter.com/intent/tweet?text=${enc(title)}&url=${enc(url)}`,
  },
  {
    label: 'Facebook',
    href:  `https://www.facebook.com/sharer/sharer.php?u=${enc(url)}`,
  },
  {
    label: 'LinkedIn',
    href:  `https://www.linkedin.com/sharing/share-offsite/?url=${enc(url)}`,
  },
  {
    label: 'WhatsApp',
    href:  `https://api.whatsapp.com/send?text=${enc(title)}%20${enc(url)}`,
  },
];
---

<div class="share-row">
  {platforms.map((p, i) => (
    <>
      {i > 0 && <span class="share-row__sep" aria-hidden="true">/</span>}
      <a
        href={p.href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Compartir en ${p.label}`}
        class="share-row__link"
      >
        {p.label}
      </a>
    </>
  ))}
</div>

<style>
  .share-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .share-row__sep {
    color: var(--fog);
    font-size: var(--text-xs);
    line-height: 1;
    user-select: none;
  }

  .share-row__link {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--stone);
    text-decoration: none;
    transition: color var(--transition-fast);
    padding-bottom: 1px;
    border-bottom: 1px solid transparent;
  }

  .share-row__link:hover {
    color: var(--ink);
    border-bottom-color: var(--blood);
  }
</style>
