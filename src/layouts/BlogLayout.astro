---
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: string;
  category: string;
  series?: string;
  tags?: string[];
  prevPost?: { slug: string; title: string } | null;
  nextPost?: { slug: string; title: string } | null;
}

import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ShareButtons from '../components/ShareButtons.astro';
import HighlightShare from '../components/HighlightShare.astro';

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  category,
  series,
  tags,
  prevPost,
  nextPost,
} = Astro.props;

const articleUrl = Astro.url.href;

const formattedDate = pubDate.toLocaleDateString('es-ES', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const formattedUpdatedDate = updatedDate?.toLocaleDateString('es-ES', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// Reading time estimate (avg 200 words/min)
// We can't count words server-side from slot content, so we use a placeholder
// that gets updated client-side via JS
---

<BaseLayout title={title} description={description} ogImage={heroImage} ogType="article">

  <!-- Reading progress bar -->
  <div class="reading-progress" id="reading-progress" aria-hidden="true"></div>

  <Header />

  <main id="main-content">

    <!-- =====================
         HERO — full-bleed
         ===================== -->
    <section
      class="article-hero"
      class:list={[{ 'article-hero--with-image': !!heroImage }]}
      style={heroImage ? `--hero-image: url('${heroImage}')` : ''}
    >
      <div class="article-hero__overlay"></div>
      <div class="article-hero__content container container--blog">
        <div class="article-hero__meta animate-fade-in">
          {series && (
            <a href={`/articulos?serie=${series}`} class="article-hero__series">{series}</a>
          )}
          {!series && (
            <span class="article-hero__category">{category}</span>
          )}
          <time datetime={pubDate.toISOString()} class="article-hero__date">
            {formattedDate}
          </time>
          <span class="article-hero__reading-time" id="reading-time">· leyendo...</span>
        </div>

        <h1 class="article-hero__title animate-fade-in-up animate-delay-1">
          {title}
        </h1>

        {description !== title && (
          <p class="article-hero__excerpt animate-fade-in-up animate-delay-2">
            {description}
          </p>
        )}
      </div>
    </section>

    <!-- =====================
         ARTICLE BODY
         ===================== -->
    <article class="article-body" id="article-body">
      <div class="container container--blog">

        <div class="prose" id="article-content">
          <slot />
        </div>

        <!-- Signature -->
        <p class="article-signature">
          Con entusiasmo, <em>~Ibai Fernández</em>
          {updatedDate && (
            <span class="article-updated">
              · Actualizado el <time datetime={updatedDate.toISOString()}>{formattedUpdatedDate}</time>
            </span>
          )}
        </p>

        <!-- Tags -->
        {tags && tags.length > 0 && (
          <div class="article-tags">
            {tags.map((tag) => (
              <span class="article-tag">#{tag}</span>
            ))}
          </div>
        )}

        <!-- Share -->
        <div class="article-share">
          <span class="article-share__label">Compartir</span>
          <ShareButtons title={title} url={articleUrl} />
        </div>

        <!-- Series navigation -->
        {(prevPost || nextPost) && (
          <nav class="series-nav" aria-label="Artículos de la serie">
            {prevPost ? (
              <a href={`/blog/${prevPost.slug}`} class="series-nav__link series-nav__link--prev">
                <span class="series-nav__label">← Anterior</span>
                <span class="series-nav__title">{prevPost.title}</span>
              </a>
            ) : <span></span>}
            {nextPost ? (
              <a href={`/blog/${nextPost.slug}`} class="series-nav__link series-nav__link--next">
                <span class="series-nav__label">Siguiente →</span>
                <span class="series-nav__title">{nextPost.title}</span>
              </a>
            ) : <span></span>}
          </nav>
        )}

      </div>
    </article>

    <!-- =====================
         WRITE ME CTA
         ===================== -->
    <section class="article-contact">
      <div class="container container--blog">
        <div class="article-contact__inner">
          <p class="article-contact__text">
            ¿Algo que añadir?
          </p>
          <a href="/hablemos" class="article-contact__link">
            Escríbeme directamente →
          </a>
        </div>
      </div>
    </section>

  </main>

  <HighlightShare />
  <Footer />

</BaseLayout>

<style>
  /* =====================
     HERO
     ===================== */

  .article-hero {
    position: relative;
    min-height: 72vh;
    display: flex;
    align-items: flex-end;
    padding-top: var(--header-height);
    background-color: var(--ink);
    overflow: hidden;
  }

  .article-hero--with-image {
    background-image: var(--hero-image);
    background-size: cover;
    background-position: center top;
  }

  .article-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(14, 12, 10, 0.2) 0%,
      rgba(14, 12, 10, 0.55) 50%,
      rgba(14, 12, 10, 0.92) 100%
    );
  }

  .article-hero__content {
    position: relative;
    z-index: 1;
    padding-bottom: var(--space-16);
    padding-top: var(--space-16);
  }

  .article-hero__meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }

  .article-hero__series,
  .article-hero__category {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--blood-light);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .article-hero__series:hover {
    color: var(--fog-light);
  }

  .article-hero__date,
  .article-hero__reading-time {
    font-size: var(--text-sm);
    color: var(--text-on-dark-muted);
  }

  .article-hero__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 500;
    line-height: 1.1;
    color: var(--text-on-dark);
    margin-bottom: var(--space-6);
    max-width: 800px;
  }

  .article-hero__excerpt {
    font-size: var(--text-xl);
    color: var(--text-on-dark-muted);
    line-height: var(--leading-relaxed);
    max-width: 600px;
    margin: 0;
  }

  /* =====================
     BODY
     ===================== */

  .article-body {
    background-color: var(--cream);
    padding: var(--space-16) 0 var(--space-20);
  }

  .article-updated {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-style: normal;
    color: var(--text-muted);
  }

  /* Tags */
  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-8);
    padding-top: var(--space-8);
    border-top: 1px solid var(--fog);
  }

  .article-tag {
    font-size: var(--text-sm);
    color: var(--stone);
    background-color: var(--fog-light);
    padding: var(--space-1) var(--space-3);
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  /* Share row */
  .article-share {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--fog);
  }

  .article-share__label {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--stone);
  }

  /* =====================
     CONTACT CTA
     ===================== */

  .article-contact {
    background-color: var(--ink);
    padding: var(--space-16) 0;
  }

  .article-contact__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
    flex-wrap: wrap;
  }

  .article-contact__text {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 400;
    font-style: italic;
    color: var(--text-on-dark-muted);
    margin: 0;
  }

  .article-contact__link {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--blood-light);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--transition-fast);
  }

  .article-contact__link:hover {
    color: var(--fog-light);
  }

  @media (max-width: 600px) {
    .article-contact__inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  /* =====================
     PULLQUOTE ATTRIBUTION CARD
     ===================== */

  .pullquote-card {
    margin: var(--space-12) calc(-1 * var(--space-6));
  }

  .pullquote-card blockquote {
    background-color: var(--ink);
    color: var(--text-on-dark);
    border-left: none;
    padding: var(--space-10) var(--space-10) var(--space-8);
    margin: 0;
  }

  .pullquote-card blockquote p {
    color: var(--text-on-dark);
  }

  .pullquote-card__attribution {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    background-color: var(--ink-soft);
    padding: var(--space-5) var(--space-10);
  }

  .pullquote-card__avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center top;
    border: 2px solid var(--blood);
    flex-shrink: 0;
    /* override prose img bleed */
    width: 44px !important;
    max-width: 44px !important;
    margin: 0 !important;
    border-top: none !important;
    display: inline-block !important;
  }

  .pullquote-card__name {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text-on-dark);
  }

  .pullquote-card__role {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-on-dark-muted);
    margin-top: 2px;
  }

  /* =====================
     INLINE NEWSLETTER
     ===================== */

  .prose-newsletter {
    margin: var(--space-14) calc(-1 * var(--space-6));
    background-color: var(--paper);
    border-top: 3px solid var(--blood);
    padding: var(--space-8) var(--space-10);
  }

  .prose-newsletter__eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--blood);
    margin-bottom: var(--space-3);
  }

  .prose-newsletter__heading {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2.5vw, 1.6rem);
    font-style: italic;
    font-weight: 400;
    color: var(--ink);
    margin-bottom: var(--space-6);
    line-height: 1.3;
  }

  .prose-newsletter__form {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .prose-newsletter__input {
    flex: 1;
    min-width: 160px;
    padding: var(--space-3) var(--space-4);
    background-color: var(--cream);
    border: 1px solid var(--fog);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--ink);
    border-radius: 0;
    appearance: none;
    transition: border-color var(--transition-fast);
  }

  .prose-newsletter__input::placeholder {
    color: var(--stone);
    opacity: 0.7;
  }

  .prose-newsletter__input:focus {
    outline: none;
    border-color: var(--blood);
  }

  .prose-newsletter__btn {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--cream);
    background-color: var(--blood);
    border: none;
    padding: var(--space-3) var(--space-7);
    cursor: pointer;
    white-space: nowrap;
    transition: background-color var(--transition-fast);
  }

  .prose-newsletter__btn:hover {
    background-color: var(--blood-hover);
  }

  .prose-newsletter__btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .prose-newsletter__ok {
    display: none;
    margin-top: var(--space-4);
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-base);
    color: var(--stone);
  }

  .prose-newsletter__ok.is-visible {
    display: block;
  }

  /* =====================
     RESPONSIVE
     ===================== */

  @media (max-width: 768px) {
    .article-hero {
      min-height: 60vh;
    }

    .article-hero__title {
      font-size: var(--text-4xl);
    }

    .article-hero__excerpt {
      font-size: var(--text-lg);
    }
  }

  @media (max-width: 480px) {
    .article-hero__title {
      font-size: var(--text-3xl);
    }
  }
</style>

<script>
  // ---- Reading progress bar ----
  const progressBar = document.getElementById('reading-progress');
  const articleBody = document.getElementById('article-body');

  if (progressBar && articleBody) {
    const updateProgress = () => {
      const bodyTop    = articleBody.offsetTop;
      const bodyHeight = articleBody.offsetHeight;
      const winHeight  = window.innerHeight;
      const scrollTop  = window.scrollY;
      const progress   = Math.min(
        100,
        Math.max(0, ((scrollTop + winHeight - bodyTop) / bodyHeight) * 100)
      );
      progressBar.style.width = `${progress}%`;
    };
    window.addEventListener('scroll', updateProgress, { passive: true });
    updateProgress();
  }

  // ---- Estimated reading time ----
  const articleContent = document.getElementById('article-content');
  const readingTimeEl  = document.getElementById('reading-time');

  if (articleContent && readingTimeEl) {
    const words   = articleContent.innerText.trim().split(/\s+/).length;
    const minutes = Math.max(1, Math.ceil(words / 200));
    readingTimeEl.textContent = `· ${minutes} min de lectura`;
  }

  // ---- Pullquote attribution cards ----
  // Detect: blockquote immediately followed by a <p> containing only an <img>
  // → wrap both in .pullquote-card with circular avatar + attribution
  if (articleContent) {
    const blockquotes = articleContent.querySelectorAll('blockquote');
    blockquotes.forEach((bq) => {
      const next = bq.nextElementSibling;
      if (!next || next.tagName !== 'P') return;
      const img = next.querySelector('img');
      if (!img || next.children.length !== 1) return;

      // Parse alt: "Nombre, Rol" or just "Nombre"
      const altText  = img.getAttribute('alt') ?? '';
      const altParts = altText.split(',');
      const name     = altParts[0]?.trim() ?? '';
      const role     = altParts[1]?.trim() ?? '';

      const card = document.createElement('div');
      card.className = 'pullquote-card';

      const attribution = document.createElement('div');
      attribution.className = 'pullquote-card__attribution';
      attribution.innerHTML = `
        <img src="${img.getAttribute('src')}" alt="${altText}" class="pullquote-card__avatar">
        <div>
          ${name ? `<p class="pullquote-card__name">${name}</p>` : ''}
          ${role ? `<p class="pullquote-card__role">${role}</p>` : ''}
        </div>
      `;

      // Wrap blockquote + attribution
      bq.parentNode!.insertBefore(card, bq);
      card.appendChild(bq);
      card.appendChild(attribution);
      next.remove(); // remove the original <p><img></p>
    });
  }

  // ---- Inline newsletter injection ----
  // Insert after the 2nd H2 in the article
  if (articleContent) {
    const headings = articleContent.querySelectorAll('h2');
    const target   = headings[1] ?? headings[0]; // 2nd H2, fallback to 1st
    if (target) {
      const nl = document.createElement('div');
      nl.className = 'prose-newsletter';
      nl.innerHTML = `
        <p class="prose-newsletter__eyebrow">Newsletter</p>
        <p class="prose-newsletter__heading">
          ¿Te está gustando lo que lees?<br>
          Puedo enviarte más cada mes.
        </p>
        <form class="prose-newsletter__form" data-nl-form>
          <input
            type="text"
            name="name"
            placeholder="Tu nombre"
            autocomplete="given-name"
            class="prose-newsletter__input"
          />
          <input
            type="email"
            name="email"
            placeholder="tu@correo.com"
            required
            autocomplete="email"
            class="prose-newsletter__input"
          />
          <button type="submit" class="prose-newsletter__btn">Suscribirme</button>
        </form>
        <p class="prose-newsletter__ok" data-nl-ok>Suscrito. Bienvenido.</p>
      `;

      // Insert AFTER the target heading's parent section or after the heading itself
      target.insertAdjacentElement('afterend', nl);

      // Wire up form submission
      const form = nl.querySelector('[data-nl-form]') as HTMLFormElement | null;
      const okEl = nl.querySelector('[data-nl-ok]') as HTMLElement | null;
      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = form.querySelector('button') as HTMLButtonElement;
        btn.disabled = true;
        btn.textContent = '…';
        try {
          const fd   = new FormData(form);
          const res  = await fetch('/api/subscribe', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              email: (fd.get('email') as string)?.trim(),
              name:  (fd.get('name')  as string)?.trim() || undefined,
            }),
          });
          if (res.ok) {
            form.style.display = 'none';
            if (okEl) okEl.classList.add('is-visible');
          } else {
            btn.disabled = false;
            btn.textContent = 'Suscribirme';
          }
        } catch {
          btn.disabled = false;
          btn.textContent = 'Suscribirme';
        }
      });
    }
  }
</script>
