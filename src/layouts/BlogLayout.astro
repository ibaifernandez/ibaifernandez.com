---
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: string;
  category: string;
  tags?: string[];
}

import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ShareButtons from '../components/ShareButtons.astro';
import HighlightShare from '../components/HighlightShare.astro';

const { title, description, pubDate, updatedDate, heroImage, category, tags } = Astro.props;
const articleUrl = Astro.url.href;

const formattedDate = pubDate.toLocaleDateString('es-ES', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const formattedUpdatedDate = updatedDate?.toLocaleDateString('es-ES', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={title} description={description} ogImage={heroImage} ogType="article">
  <Header />

  <main class="blog-post" style={`padding-top: var(--header-height);`}>
    <!-- Hero -->
    <div class="blog-post__hero section--dark">
      <div class="container container--blog">
        <div class="blog-post__meta animate-fade-in-up">
          <a href={`/articulos?cat=${category}`} class="blog-post__category">{category}</a>
          <time datetime={pubDate.toISOString()}>{formattedDate}</time>
          {updatedDate && (
            <span class="blog-post__updated">
              · Actualizado: <time datetime={updatedDate.toISOString()}>{formattedUpdatedDate}</time>
            </span>
          )}
        </div>
        <h1 class="blog-post__title animate-fade-in-up animate-delay-1">{title}</h1>
        <p class="blog-post__excerpt animate-fade-in-up animate-delay-2">{description}</p>
      </div>
    </div>

    {heroImage && (
      <div class="blog-post__hero-image container container--blog">
        <img src={heroImage} alt={title} loading="eager" />
      </div>
    )}

    <!-- Content -->
    <article class="blog-post__content container container--blog">
      <div class="prose" id="article-content">
        <slot />
      </div>

      {tags && tags.length > 0 && (
        <div class="blog-post__tags">
          {tags.map((tag) => (
            <span class="blog-post__tag">#{tag}</span>
          ))}
        </div>
      )}

      <ShareButtons title={title} url={articleUrl} />
    </article>

    <!-- Comments -->
    <section class="blog-post__comments container container--blog" id="comments">
      <h2>Comentarios</h2>
      <div id="giscus-container">
        <script
          src="https://giscus.app/client.js"
          data-repo="ibaifernandez/ibaifernandez.com"
          data-repo-id=""
          data-category="Comments"
          data-category-id=""
          data-mapping="pathname"
          data-strict="0"
          data-reactions-enabled="1"
          data-emit-metadata="0"
          data-input-position="top"
          data-theme="preferred_color_scheme"
          data-lang="es"
          crossorigin="anonymous"
          async
        ></script>
      </div>
      <p class="blog-post__comments-note">
        Los comentarios requieren una cuenta de GitHub. Si no tienes una, puedes
        <a href="/contacto">escribirme directamente</a>.
      </p>
    </section>
  </main>

  <HighlightShare />
  <Footer />
</BaseLayout>

<style>
  .blog-post__hero {
    padding: var(--space-20) 0 var(--space-12);
  }

  .blog-post__meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text-on-dark-muted);
    margin-bottom: var(--space-6);
  }

  .blog-post__category {
    background-color: var(--color-accent-secondary);
    color: var(--color-bg-white);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-decoration: none;
  }

  .blog-post__category:hover {
    background-color: var(--color-accent-secondary-hover);
    color: var(--color-bg-white);
  }

  .blog-post__title {
    font-size: var(--text-5xl);
    color: var(--color-text-on-dark);
    margin-bottom: var(--space-4);
  }

  .blog-post__excerpt {
    font-size: var(--text-xl);
    color: var(--color-text-on-dark-muted);
    line-height: var(--leading-relaxed);
    max-width: 600px;
  }

  .blog-post__hero-image {
    margin-top: calc(-1 * var(--space-8));
    margin-bottom: var(--space-12);
  }

  .blog-post__hero-image img {
    width: 100%;
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-xl);
  }

  .blog-post__content {
    padding: var(--space-12) var(--space-6);
  }

  .blog-post__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-8);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }

  .blog-post__tag {
    font-size: var(--text-sm);
    color: var(--color-accent-secondary);
    background-color: rgba(14, 165, 233, 0.08);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    font-weight: 500;
  }

  .blog-post__comments {
    padding: var(--space-12) var(--space-6);
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-8);
  }

  .blog-post__comments h2 {
    margin-bottom: var(--space-6);
  }

  .blog-post__comments-note {
    margin-top: var(--space-6);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .blog-post__title {
      font-size: var(--text-3xl);
    }

    .blog-post__hero {
      padding: var(--space-12) 0 var(--space-8);
    }
  }
</style>
