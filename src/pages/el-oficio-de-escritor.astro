---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const allPosts = await getCollection('blog', (p) => !p.data.draft);
const posts = allPosts
  .filter((p) => (p.data as any).series === 'El Oficio de Escritor')
  .sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf());
---

<BaseLayout
  title="El Oficio de Escritor — Ibai Fernández"
  description="Una serie sobre escribir de verdad: el bloqueo, la voz, la inspiración, la originalidad, los editores y todo lo que nadie te cuenta."
>
  <Header />

  <main id="main-content">

    <!-- HERO -->
    <section class="ofe-hero">
      <div class="container">
        <div class="ofe-hero__content">
          <p class="ofe-hero__eyebrow animate-fade-in">Serie</p>
          <h1 class="ofe-hero__title animate-fade-in-up animate-delay-1">
            El Oficio<br />
            <em>de Escritor</em>
          </h1>
          <p class="ofe-hero__sub animate-fade-in-up animate-delay-2">
            Una serie sobre escribir de verdad. El bloqueo, la voz, la inspiración,
            la originalidad, los editores y todo lo que nadie te cuenta.
          </p>
        </div>
      </div>
    </section>

    <!-- EBOOK CTA -->
    <section class="ofe-ebook">
      <div class="container">
        <div class="ofe-ebook__inner">
          <div class="ofe-ebook__cover">
            <span class="ofe-ebook__cover-text">El Oficio<br />de Escritor<br /><em>Vol. I</em></span>
          </div>
          <div class="ofe-ebook__info">
            <p class="ofe-ebook__eyebrow">Ebook gratuito</p>
            <h2 class="ofe-ebook__title">Empieza por el principio</h2>
            <p class="ofe-ebook__desc">
              <em>Reflexiones de un escritor primerizo</em> — el primer volumen de esta serie
              en formato libro. Descárgalo gratis y léelo antes de continuar con los artículos.
            </p>
            <a href="/el-oficio-de-escritor-vol-1" class="ofe-ebook__btn">
              Descargar Vol. I gratis →
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ARTICLE LIST -->
    <section class="ofe-articles">
      <div class="container">
        <p class="ofe-articles__eyebrow">Artículos de la serie · {posts.length} entregas</p>
        <ol class="ofe-list">
          {posts.map((post, i) => (
            <li class="ofe-item">
              <span class="ofe-item__num">{String(i + 1).padStart(2, '0')}</span>
              <div class="ofe-item__body">
                <a href={`/blog/${post.id}`} class="ofe-item__title">
                  {post.data.title}
                </a>
                <p class="ofe-item__desc">{post.data.description}</p>
              </div>
              <a href={`/blog/${post.id}`} class="ofe-item__arrow" aria-hidden="true">→</a>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- CTA -->
    <section class="ofe-cta">
      <div class="container container--narrow">
        <div class="ofe-cta__inner">
          <p class="ofe-cta__text">
            ¿Tienes algo que añadir sobre el oficio?
          </p>
          <a href="/hablemos" class="ofe-cta__link">Escríbeme →</a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>

<style>
  .ofe-hero {
    background-color: var(--ink);
    padding-top: var(--header-height);
    min-height: 65vh;
    display: flex;
    align-items: flex-end;
  }

  .ofe-hero__content {
    padding-bottom: var(--space-20);
    padding-top: var(--space-16);
  }

  .ofe-hero__eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--blood-light);
    margin-bottom: var(--space-4);
  }

  .ofe-hero__title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 8vw, 7rem);
    font-weight: 300;
    line-height: 0.95;
    color: var(--text-on-dark);
    margin-bottom: var(--space-8);
    letter-spacing: -0.01em;
  }

  .ofe-hero__sub {
    font-size: var(--text-lg);
    color: var(--text-on-dark-muted);
    max-width: 520px;
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  /* Ebook */
  .ofe-ebook {
    background-color: var(--paper);
    padding: var(--space-16) 0;
    border-bottom: 1px solid var(--fog);
  }

  .ofe-ebook__inner {
    display: flex;
    gap: var(--space-12);
    align-items: center;
  }

  .ofe-ebook__cover {
    width: 120px;
    min-width: 120px;
    aspect-ratio: 2/3;
    background-color: var(--ink);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-4);
    box-shadow: 6px 6px 0 var(--fog);
    flex-shrink: 0;
  }

  .ofe-ebook__cover-text {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--cream);
    text-align: center;
    line-height: 1.4;
  }

  .ofe-ebook__eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--blood);
    margin-bottom: var(--space-2);
  }

  .ofe-ebook__title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 500;
    color: var(--ink);
    margin-bottom: var(--space-3);
  }

  .ofe-ebook__desc {
    font-size: var(--text-base);
    color: var(--stone);
    line-height: var(--leading-relaxed);
    max-width: 480px;
    margin-bottom: var(--space-5);
  }

  .ofe-ebook__btn {
    display: inline-block;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--cream);
    background-color: var(--blood);
    text-decoration: none;
    padding: var(--space-3) var(--space-8);
    transition: background-color var(--transition-fast);
  }

  .ofe-ebook__btn:hover {
    background-color: var(--blood-hover);
  }

  /* Article list */
  .ofe-articles {
    background-color: var(--cream);
    padding: var(--space-16) 0 var(--space-20);
  }

  .ofe-articles__eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--stone);
    margin-bottom: var(--space-10);
  }

  .ofe-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--fog);
  }

  .ofe-item {
    display: flex;
    align-items: baseline;
    gap: var(--space-6);
    padding: var(--space-6) 0;
    border-bottom: 1px solid var(--fog);
    transition: background-color var(--transition-fast);
  }

  .ofe-item:hover {
    background-color: var(--paper);
    margin: 0 calc(-1 * var(--space-4));
    padding-left: var(--space-4);
    padding-right: var(--space-4);
  }

  .ofe-item__num {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 300;
    color: var(--fog);
    line-height: 1;
    min-width: 2.5rem;
    flex-shrink: 0;
  }

  .ofe-item__body {
    flex: 1;
  }

  .ofe-item__title {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    font-weight: 500;
    font-style: italic;
    color: var(--ink);
    text-decoration: none;
    display: block;
    margin-bottom: var(--space-1);
    transition: color var(--transition-fast);
  }

  .ofe-item__title:hover {
    color: var(--blood);
  }

  .ofe-item__desc {
    font-size: var(--text-sm);
    color: var(--stone);
    margin: 0;
    line-height: var(--leading-relaxed);
  }

  .ofe-item__arrow {
    font-size: var(--text-base);
    color: var(--fog);
    text-decoration: none;
    flex-shrink: 0;
    transition: color var(--transition-fast);
  }

  .ofe-item:hover .ofe-item__arrow {
    color: var(--blood);
  }

  /* CTA */
  .ofe-cta {
    background-color: var(--ink);
    padding: var(--space-16) 0;
  }

  .ofe-cta__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
    flex-wrap: wrap;
  }

  .ofe-cta__text {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2.5vw, 1.6rem);
    font-style: italic;
    color: var(--text-on-dark-muted);
    margin: 0;
  }

  .ofe-cta__link {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--blood-light);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--transition-fast);
  }

  .ofe-cta__link:hover { color: var(--fog-light); }

  @media (max-width: 700px) {
    .ofe-ebook__inner {
      flex-direction: column;
      align-items: flex-start;
    }
    .ofe-cta__inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
