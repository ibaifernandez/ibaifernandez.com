---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="2×2 — Cortometraje de Ibai Fernández"
  description="2×2 es un cortometraje escrito y dirigido por Ibai Fernández. Filmado en Málaga en 2013, editado entre Málaga y Quito en 2014."
>
  <Header />

  <main id="main-content">

    <!-- HERO -->
    <section class="film-hero">
      <div class="film-hero__overlay"></div>
      <div class="film-hero__content container">
        <p class="film-hero__eyebrow animate-fade-in">Cortometraje · 2015</p>
        <h1 class="film-hero__title animate-fade-in-up animate-delay-1">
          2<span class="film-hero__times">×</span>2
        </h1>
        <p class="film-hero__credit animate-fade-in-up animate-delay-2">
          Un cortometraje de Ibai Fernández
        </p>
      </div>
    </section>

    <!-- POSTER + CREDITS -->
    <section class="film-body">
      <div class="container container--narrow">

        <div class="film-poster">
          <img
            src="/images/wp-archive/2x2-ibai-fernandez-pdf.jpg"
            alt="2×2 — cortometraje de Ibai Fernández"
            width="800"
            height="450"
            loading="lazy"
          />
        </div>

        <div class="film-synopsis">
          <p>
            Un cortometraje sobre lo que queda cuando ya no queda nada.
            Filmado en Málaga (España) entre junio y agosto de 2013 y
            editado entre Málaga y Quito (Ecuador) entre diciembre de 2013
            y abril de 2014.
          </p>
        </div>

        <!-- Credits -->
        <table class="film-credits">
          <tbody>
            <tr>
              <th>Dirección y edición</th>
              <td>Ibai Fernández</td>
            </tr>
            <tr>
              <th>Guión</th>
              <td>Ibai Fernández, Clara Valle, Iván Aranda y <a href="https://victorcastilla.com" target="_blank" rel="noopener noreferrer">Víctor Castilla</a></td>
            </tr>
            <tr>
              <th>Producción</th>
              <td>Sara Santos e Ibai Fernández</td>
            </tr>
            <tr>
              <th>Dirección de arte</th>
              <td>Sara Santos</td>
            </tr>
            <tr>
              <th>Cinematografía</th>
              <td>Salvador Blanco</td>
            </tr>
            <tr>
              <th>Asistente de arte</th>
              <td>Alberto Ortega</td>
            </tr>
            <tr>
              <th>Sonido y partitura</th>
              <td>Juan Carlos Moya</td>
            </tr>
            <tr>
              <th>Postproducción y títulos</th>
              <td>J.J. Franco Ruiz</td>
            </tr>
            <tr>
              <th>Canción «2×2»</th>
              <td>Letra: Ibai Fernández · Música: Juan Carlos Moya · Voz: Marta Guzmán</td>
            </tr>
            <tr>
              <th>Agradecimientos</th>
              <td>Paco Bravo, Marco DiTieri, Edu Poveda, Javier Santos, Inés Gutiérrez, Antonio Fernández y Cepe le Pew</td>
            </tr>
            <tr>
              <th>Producido por</th>
              <td><a href="https://elmst.tv" target="_blank" rel="noopener noreferrer">Elm St. Productions</a> &amp; Ibai Fernández · Todos los derechos reservados · 2015</td>
            </tr>
          </tbody>
        </table>

      </div>
    </section>

    <!-- CTA -->
    <section class="film-cta">
      <div class="container container--narrow">
        <div class="film-cta__inner">
          <p class="film-cta__text">¿Te gustó lo que ves?</p>
          <a href="/fotografia" class="film-cta__link">Ver más trabajo →</a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>

<style>
  /* ── Hero ──────────────────────────────────────────────────── */
  .film-hero {
    position: relative;
    min-height: 65vh;
    display: flex;
    align-items: flex-end;
    padding-top: var(--header-height);
    background-color: var(--ink);
    overflow: hidden;
  }

  .film-hero__overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center bottom, rgba(155,32,32,0.15) 0%, transparent 70%);
  }

  .film-hero__content {
    position: relative;
    z-index: 1;
    padding-bottom: var(--space-20);
    padding-top: var(--space-16);
  }

  .film-hero__eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--blood-light);
    margin-bottom: var(--space-3);
  }

  .film-hero__title {
    font-family: var(--font-display);
    font-size: clamp(5rem, 18vw, 14rem);
    font-weight: 300;
    line-height: 0.9;
    color: var(--cream);
    letter-spacing: -0.03em;
    margin-bottom: var(--space-4);
  }

  .film-hero__times {
    color: var(--blood);
  }

  .film-hero__credit {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-style: italic;
    font-weight: 300;
    color: var(--text-on-dark-muted);
    margin: 0;
  }

  /* ── Body ──────────────────────────────────────────────────── */
  .film-body {
    background-color: var(--cream);
    padding: var(--space-16) 0 var(--space-20);
  }

  .film-poster {
    margin-bottom: var(--space-10);
    border-top: 3px solid var(--blood);
    overflow: hidden;
  }

  .film-poster img {
    width: 100%;
    height: auto;
    display: block;
    border-top: none;
  }

  .film-synopsis {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--stone);
    max-width: 60ch;
    margin-bottom: var(--space-12);
  }

  .film-synopsis p { margin: 0; }

  /* ── Credits table ─────────────────────────────────────────── */
  .film-credits {
    width: 100%;
    border-collapse: collapse;
    border-top: 1px solid var(--fog);
  }

  .film-credits tr {
    border-bottom: 1px solid var(--fog);
  }

  .film-credits th,
  .film-credits td {
    padding: var(--space-3) var(--space-2);
    text-align: left;
    vertical-align: top;
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .film-credits th {
    font-family: var(--font-body);
    font-weight: 600;
    font-style: normal;
    color: var(--stone);
    letter-spacing: 0.04em;
    white-space: nowrap;
    width: 32%;
    padding-right: var(--space-6);
  }

  .film-credits td {
    font-family: var(--font-body);
    color: var(--ink);
  }

  .film-credits a {
    color: var(--blood);
    text-decoration: none;
  }
  .film-credits a:hover { text-decoration: underline; }

  /* ── CTA ───────────────────────────────────────────────────── */
  .film-cta {
    background-color: var(--ink);
    padding: var(--space-16) 0;
  }

  .film-cta__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
    flex-wrap: wrap;
  }

  .film-cta__text {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2.5vw, 1.6rem);
    font-style: italic;
    color: var(--text-on-dark-muted);
    margin: 0;
  }

  .film-cta__link {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--blood-light);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--transition-fast);
  }

  .film-cta__link:hover { color: var(--fog-light); }

  @media (max-width: 600px) {
    .film-cta__inner { flex-direction: column; align-items: flex-start; }
    .film-credits th { width: auto; white-space: normal; }
  }
</style>
