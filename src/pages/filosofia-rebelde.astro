---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

// Pull all posts tagged with this series
const allPosts = (await getCollection('blog'))
  .filter((p) => {
    const s = (p.data as any).series;
    return !p.data.draft && s === 'Filosofía Rebelde';
  })
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const principios = [
  {
    numero: 'I',
    nombre: 'Principio de Plenitud Personal',
    cuerpo:
      'Cada ser humano posee un potencial único e irrepetible. La vida extraordinaria comienza cuando dejamos de medir nuestro valor con el rasero ajeno y comenzamos a descubrir —con rigor y sin concesiones— cuál es nuestro propósito singular en el mundo.',
  },
  {
    numero: 'II',
    nombre: 'Principio de la Autenticidad y la Exploración Continua',
    cuerpo:
      'Las expectativas sociales son una jaula invisible. Rechazarlas no es un acto de adolescente rebeldía: es la condición necesaria para vivir con coherencia. La autenticidad no es un destino; es una práctica constante de escucha interior y ajuste valiente.',
  },
  {
    numero: 'III',
    nombre: 'Principio de la Auténtica Rebeldía',
    cuerpo:
      'Cuestionar el status quo no es deporte ni pose. Es una obligación intelectual. La rebeldía que defendemos no nace del capricho sino del pensamiento crítico: la resistencia consciente y documentada contra la mediocridad como norma y el conformismo como destino.',
  },
  {
    numero: 'IV',
    nombre: 'Principio de la Mentalidad Abierta y Adaptable',
    cuerpo:
      'El conocimiento es infinito; la certeza, provisional. Una mente que se cierra muere antes que el cuerpo que la aloja. Mantener la flexibilidad intelectual —la disposición a ser contradicho, a cambiar de opinión con elegancia— es una forma de respeto hacia la realidad.',
  },
  {
    numero: 'V',
    nombre: 'Principio de Empatía y Compasión',
    cuerpo:
      'La inteligencia sin empatía es simplemente potencia sin dirección. Entender antes de juzgar, escuchar antes de responder, sentir antes de actuar: la empatía no es debilidad sino el fundamento de toda conexión humana auténtica y duradera.',
  },
];
---

<BaseLayout
  title="Filosofía Rebelde"
  description="La puerta a una vida extraordinaria. El manifiesto de Ibai Fernández: cinco principios para cuestionar lo establecido y vivir con autenticidad radical."
>
  <Header />

  <main class="fr-page">

    <!-- =====================================================
         OPENING — FULL-BLEED TITLE
         ===================================================== -->
    <section class="fr-opening">
      <div class="container container--narrow">
        <p class="fr-opening__eyebrow animate-fade-in">Ibai Fernández</p>
        <h1 class="fr-opening__title animate-fade-in-up animate-delay-1">
          Filosofía<br/><em>Rebelde</em>
        </h1>
        <p class="fr-opening__sub animate-fade-in-up animate-delay-2">
          La puerta a una vida extraordinaria.
        </p>
      </div>
    </section>

    <!-- =====================================================
         THESIS
         ===================================================== -->
    <section class="fr-thesis section--paper">
      <div class="container container--narrow">
        <p class="fr-thesis__text animate-fade-in-up">
          Sistemáticamente cuestionar las convenciones sociales y las creencias pre-establecidas
          no es una actitud cómoda. Tampoco es una tendencia. Es una obligación para quienes
          aspiran a una vida que merezca ese nombre.
        </p>
        <p class="fr-thesis__text animate-fade-in-up animate-delay-1">
          La Filosofía Rebelde no es nihilismo ni anarquía. Es rigor aplicado a la existencia:
          la negativa a aceptar como verdad lo que simplemente es costumbre.
        </p>
      </div>
    </section>

    <!-- =====================================================
         LOS CINCO PRINCIPIOS
         ===================================================== -->
    <section class="fr-principios section--dark">
      <div class="container container--narrow">
        <p class="fr-principios__label">Los cinco principios</p>

        {principios.map((p, i) => (
          <div class="fr-principio animate-fade-in-up" style={`animation-delay: ${i * 0.1}s`}>
            <div class="fr-principio__header">
              <span class="fr-principio__numero">{p.numero}</span>
              <h2 class="fr-principio__nombre">{p.nombre}</h2>
            </div>
            <p class="fr-principio__cuerpo">{p.cuerpo}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- =====================================================
         QUOTE
         ===================================================== -->
    <section class="fr-quote section--paper">
      <div class="container container--narrow">
        <blockquote class="fr-quote__text animate-fade-in-up">
          «No somos héroes. Pero podemos ser extraordinarios.»
        </blockquote>
        <p class="fr-quote__attr animate-fade-in-up animate-delay-1">
          — Ibai Fernández, <em>Filosofía Rebelde</em>
        </p>
      </div>
    </section>

    <!-- =====================================================
         ARTÍCULOS DE FILOSOFÍA REBELDE
         ===================================================== -->
    {allPosts.length > 0 && (
      <section class="fr-articles section--cream">
        <div class="container container--narrow">
          <h2 class="fr-articles__title animate-fade-in-up">
            Ensayos de la ComunidadRebelde
          </h2>
          <ul class="fr-articles__list">
            {allPosts.map((post, i) => (
              <li class="fr-articles__item animate-fade-in-up" style={`animation-delay: ${i * 0.05}s`}>
                <a href={`/blog/${post.id}`} class="fr-articles__link">
                  <span class="fr-articles__post-title">{post.data.title}</span>
                  <time
                    datetime={post.data.pubDate.toISOString()}
                    class="fr-articles__date"
                  >
                    {post.data.pubDate.toLocaleDateString('es-ES', { year: 'numeric', month: 'short' })}
                  </time>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    <!-- =====================================================
         CTA NEWSLETTER
         ===================================================== -->
    <section class="fr-newsletter section--dark">
      <div class="container container--narrow">
        <div class="fr-newsletter__inner animate-fade-in-up">
          <h2 class="fr-newsletter__title">
            La ComunidadRebelde<br/>te está esperando.
          </h2>
          <p class="fr-newsletter__sub">
            Una carta al mes. Sin autoayuda. Sin fórmulas. Solo pensamiento que rasca donde pica.
          </p>
          <form class="fr-newsletter__form" id="fr-newsletter-form" novalidate>
            <div class="fr-newsletter__field">
              <input
                type="email"
                name="email"
                placeholder="tu@email.com"
                required
                autocomplete="email"
                class="fr-newsletter__input"
              />
              <button type="submit" class="btn btn--primary">
                Unirme →
              </button>
            </div>
            <p class="fr-newsletter__feedback" id="fr-newsletter-feedback" aria-live="polite"></p>
          </form>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>

<style>
  /* =====================================================
     OPENING
     ===================================================== */

  .fr-opening {
    background-color: var(--ink);
    padding-top: calc(var(--header-height) + var(--space-20));
    padding-bottom: var(--space-20);
    border-bottom: 1px solid var(--ink-muted);
  }

  .fr-opening__eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--blood-light);
    margin-bottom: var(--space-6);
  }

  .fr-opening__title {
    font-family: var(--font-display);
    font-size: clamp(4rem, 10vw, 8rem);
    font-weight: 300;
    line-height: 0.95;
    color: var(--text-on-dark);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-8);
  }

  .fr-opening__title em {
    font-style: italic;
    color: var(--blood-light);
  }

  .fr-opening__sub {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-style: italic;
    color: var(--text-on-dark-muted);
    margin: 0;
  }

  /* =====================================================
     THESIS
     ===================================================== */

  .fr-thesis {
    padding: var(--space-24) 0;
  }

  .fr-thesis__text {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.5vw, 1.6rem);
    font-style: italic;
    line-height: 1.7;
    color: var(--text-ink);
    margin-bottom: var(--space-8);
  }

  /* =====================================================
     LOS CINCO PRINCIPIOS
     ===================================================== */

  .fr-principios {
    padding: var(--space-24) 0;
  }

  .fr-principios__label {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--blood-light);
    margin-bottom: var(--space-16);
  }

  .fr-principio {
    padding: var(--space-12) 0;
    border-top: 1px solid var(--ink-muted);
  }

  .fr-principio:last-child {
    border-bottom: 1px solid var(--ink-muted);
  }

  .fr-principio__header {
    display: flex;
    align-items: baseline;
    gap: var(--space-6);
    margin-bottom: var(--space-6);
  }

  .fr-principio__numero {
    font-family: var(--font-display);
    font-size: var(--text-6xl);
    font-weight: 300;
    color: var(--ink-muted);
    line-height: 1;
    flex-shrink: 0;
    min-width: 2.5ch;
  }

  .fr-principio__nombre {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 400;
    font-style: italic;
    color: var(--text-on-dark);
    line-height: 1.2;
    margin: 0;
  }

  .fr-principio__cuerpo {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--text-on-dark-muted);
    padding-left: calc(2.5ch + var(--space-6));
    margin: 0;
  }

  /* =====================================================
     QUOTE
     ===================================================== */

  .fr-quote {
    padding: var(--space-24) 0;
    text-align: center;
  }

  .fr-quote__text {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    font-style: italic;
    font-weight: 400;
    color: var(--text-ink);
    line-height: 1.5;
    margin-bottom: var(--space-6);
    quotes: none;
  }

  .fr-quote__attr {
    font-size: var(--text-sm);
    color: var(--text-muted);
    letter-spacing: 0.04em;
    margin: 0;
  }

  /* =====================================================
     ARTICLES LIST
     ===================================================== */

  .fr-articles {
    padding: var(--space-24) 0;
  }

  .fr-articles__title {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 400;
    font-style: italic;
    color: var(--text-ink);
    margin-bottom: var(--space-10);
  }

  .fr-articles__list {
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--fog);
  }

  .fr-articles__item {
    border-bottom: 1px solid var(--fog);
  }

  .fr-articles__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-5) 0;
    text-decoration: none;
    color: var(--text-ink);
    transition: color var(--transition-fast);
  }

  .fr-articles__link:hover {
    color: var(--blood);
  }

  .fr-articles__post-title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-style: italic;
    font-weight: 400;
    line-height: var(--leading-snug);
  }

  .fr-articles__date {
    font-size: var(--text-xs);
    color: var(--text-muted);
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* =====================================================
     NEWSLETTER
     ===================================================== */

  .fr-newsletter {
    padding: var(--space-24) 0;
  }

  .fr-newsletter__inner {
    text-align: center;
  }

  .fr-newsletter__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 300;
    font-style: italic;
    color: var(--text-on-dark);
    line-height: 1.2;
    margin-bottom: var(--space-6);
  }

  .fr-newsletter__sub {
    font-size: var(--text-lg);
    color: var(--text-on-dark-muted);
    max-width: 480px;
    margin: 0 auto var(--space-10);
  }

  .fr-newsletter__form {
    max-width: 420px;
    margin: 0 auto;
  }

  .fr-newsletter__field {
    display: flex;
    border: 1px solid rgba(240, 235, 227, 0.2);
    overflow: hidden;
  }

  .fr-newsletter__input {
    flex: 1;
    min-width: 0;
    padding: var(--space-4) var(--space-5);
    background-color: rgba(255, 255, 255, 0.06);
    border: none;
    color: var(--text-on-dark);
    font-family: var(--font-body);
    font-size: var(--text-base);
    outline: none;
    transition: background-color var(--transition-fast);
  }

  .fr-newsletter__input::placeholder {
    color: var(--text-on-dark-muted);
  }

  .fr-newsletter__input:focus {
    background-color: rgba(255, 255, 255, 0.10);
  }

  .fr-newsletter__feedback {
    font-size: var(--text-sm);
    margin-top: var(--space-3);
    min-height: 1.5em;
    text-align: center;
    color: var(--text-on-dark-muted);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .fr-principio__header {
      flex-direction: column;
      gap: var(--space-2);
    }

    .fr-principio__numero {
      font-size: var(--text-4xl);
    }

    .fr-principio__cuerpo {
      padding-left: 0;
    }
  }
</style>

<script>
  const form     = document.getElementById('fr-newsletter-form') as HTMLFormElement | null;
  const feedback = document.getElementById('fr-newsletter-feedback');

  if (form && feedback) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const emailInput = form.querySelector<HTMLInputElement>('[name="email"]');
      if (!emailInput?.value) return;

      const btn = form.querySelector<HTMLButtonElement>('[type="submit"]');
      if (btn) { btn.disabled = true; btn.textContent = 'Enviando...'; }

      try {
        const res = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: emailInput.value }),
        });

        feedback.textContent = res.ok
          ? '¡Bienvenido a la ComunidadRebelde!'
          : 'Algo salió mal. Inténtalo de nuevo.';
        if (res.ok) emailInput.value = '';
      } catch {
        feedback.textContent = 'Error de conexión. Inténtalo de nuevo.';
      } finally {
        if (btn) { btn.disabled = false; btn.textContent = 'Unirme →'; }
      }
    });
  }
</script>
