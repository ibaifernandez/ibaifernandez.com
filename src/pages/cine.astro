---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Cine — Ibai Fernández"
  description="Proyectos audiovisuales de Ibai Fernández. Cine que se mueve en los bordes entre el documental y la ficción."
>
  <Header />

  <main id="main-content">

    <!-- HERO -->
    <section class="cine-hero">
      <div class="cine-hero__overlay"></div>
      <div class="container">
        <div class="cine-hero__content">
          <p class="cine-hero__eyebrow animate-fade-in">Cine</p>
          <h1 class="cine-hero__title animate-fade-in-up animate-delay-1">
            El modo más completo<br />
            <em>de mentir sobre la verdad.</em>
          </h1>
        </div>
      </div>
    </section>

    <!-- STATEMENT -->
    <section class="cine-statement">
      <div class="container container--narrow">
        <div class="cine-prose animate-fade-in-up">
          <p class="cine-lead">
            Dirijo y produzco proyectos audiovisuales que se mueven en los bordes
            entre el documental y la ficción.
          </p>
          <p>
            No creo en la objetividad de la cámara. Creo en el punto de vista.
            En la elección de qué encuadrar y qué dejar fuera.
            En que cada corte es una interpretación del mundo.
          </p>
          <p>
            El cine que me interesa hacer —y ver— no pretende responder preguntas.
            Pretende que la pregunta se haga inevitable.
          </p>
        </div>
      </div>
    </section>

    <!-- PROJECTS — coming soon / existing -->
    <section class="cine-projects">
      <div class="container">
        <p class="cine-section__eyebrow">Proyectos</p>

        <div class="cine-project-grid">

          <article class="cine-project">
            <div class="cine-project__meta">
              <span class="cine-project__year">2023</span>
              <span class="cine-project__type">Documental</span>
            </div>
            <h2 class="cine-project__title">No somos héroes</h2>
            <p class="cine-project__desc">
              Un manual de anti-terapia. Un viaje a través del mito del héroe
              y lo que queda cuando se desmorona.
            </p>
            <a href="/blog/no-somos-heroes-prologo" class="cine-project__link">
              Leer el prólogo →
            </a>
          </article>

          <article class="cine-project cine-project--upcoming">
            <div class="cine-project__meta">
              <span class="cine-project__type cine-project__type--soon">En desarrollo</span>
            </div>
            <h2 class="cine-project__title">Próximos proyectos</h2>
            <p class="cine-project__desc">
              Si tienes una propuesta o quieres hablar sobre una colaboración audiovisual,
              escríbeme directamente.
            </p>
            <a href="/hablemos" class="cine-project__link">
              Contactar →
            </a>
          </article>

        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="cine-cta">
      <div class="container container--narrow">
        <div class="cine-cta__inner">
          <p class="cine-cta__text">
            ¿Una idea, una propuesta, una colaboración?
          </p>
          <a href="/hablemos" class="cine-cta__link">Hablemos →</a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>

<style>
  .cine-hero {
    position: relative;
    background-color: var(--ink);
    padding-top: var(--header-height);
    min-height: 70vh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }

  .cine-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom right,
      rgba(14, 12, 10, 0.0) 0%,
      rgba(155, 32, 32, 0.06) 100%
    );
    pointer-events: none;
  }

  .cine-hero__content {
    position: relative;
    padding-bottom: var(--space-20);
    padding-top: var(--space-16);
  }

  .cine-hero__eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--blood-light);
    margin-bottom: var(--space-5);
  }

  .cine-hero__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 4.5rem);
    font-weight: 400;
    line-height: 1.15;
    color: var(--text-on-dark);
    max-width: 700px;
    margin: 0;
  }

  /* Statement */
  .cine-statement {
    background-color: var(--cream);
    padding: var(--space-20) 0;
  }

  .cine-prose {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    line-height: 1.8;
    color: var(--ink);
  }

  .cine-prose p {
    margin-bottom: var(--space-6);
  }

  .cine-prose p:last-child {
    margin-bottom: 0;
  }

  .cine-lead {
    font-size: clamp(1.2rem, 2.5vw, 1.5rem) !important;
    font-weight: 500;
  }

  /* Projects */
  .cine-projects {
    background-color: var(--paper);
    padding: var(--space-16) 0 var(--space-20);
    border-top: 1px solid var(--fog);
  }

  .cine-section__eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--stone);
    margin-bottom: var(--space-10);
  }

  .cine-project-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    border-top: 1px solid var(--fog);
    border-left: 1px solid var(--fog);
  }

  .cine-project {
    padding: var(--space-10) var(--space-8);
    border-right: 1px solid var(--fog);
    border-bottom: 1px solid var(--fog);
  }

  .cine-project--upcoming {
    background-color: var(--cream);
  }

  .cine-project__meta {
    display: flex;
    gap: var(--space-3);
    align-items: center;
    margin-bottom: var(--space-4);
  }

  .cine-project__year {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--stone);
  }

  .cine-project__type {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--blood);
    padding: 2px var(--space-2);
    border: 1px solid rgba(155, 32, 32, 0.3);
  }

  .cine-project__type--soon {
    color: var(--stone);
    border-color: var(--fog);
  }

  .cine-project__title {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    font-weight: 500;
    font-style: italic;
    color: var(--ink);
    margin-bottom: var(--space-3);
  }

  .cine-project__desc {
    font-size: var(--text-base);
    color: var(--stone);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-5);
  }

  .cine-project__link {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--blood);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .cine-project__link:hover {
    color: var(--blood-light);
  }

  /* CTA */
  .cine-cta {
    background-color: var(--ink);
    padding: var(--space-16) 0;
  }

  .cine-cta__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
    flex-wrap: wrap;
  }

  .cine-cta__text {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    font-style: italic;
    color: var(--text-on-dark-muted);
    margin: 0;
  }

  .cine-cta__link {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--blood-light);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--transition-fast);
  }

  .cine-cta__link:hover {
    color: var(--fog-light);
  }

  @media (max-width: 700px) {
    .cine-project-grid {
      grid-template-columns: 1fr;
    }

    .cine-cta__inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
