---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const films = [
  {
    slug:      'noche-sin-manana',
    title:     'Noche sin mañana',
    year:      '<!-- AÑO -->',
    format:    'Cortometraje',
    synopsis:  '<!-- SINOPSIS -->',
    youtube:   'https://www.youtube.com/watch?v=m_G2yF4-5wQ',
    thumbnail: 'https://img.youtube.com/vi/m_G2yF4-5wQ/maxresdefault.jpg',
  },
  {
    slug:      '2x2',
    title:     '2×2',
    year:      '2014',
    format:    'Cortometraje',
    synopsis:  'Dos parejas. Un día. Cuatro personas que intentan entenderse mientras el tiempo se les escapa de las manos.',
    youtube:   'https://www.youtube.com/watch?v=aN9rRLCpRBs',
    thumbnail: 'https://img.youtube.com/vi/aN9rRLCpRBs/maxresdefault.jpg',
  },
];
---

<BaseLayout
  title="Cine — Ibai Fernández"
  description="Cortometrajes de Ibai Fernández. Cine que se mueve en los bordes entre el documental y la ficción."
>
  <Header />

  <main id="main-content">

    <!-- HERO -->
    <section class="cine-hero">
      <div class="cine-hero__overlay"></div>
      <div class="container">
        <div class="cine-hero__content">
          <p class="cine-hero__eyebrow animate-fade-in">Cine</p>
          <h1 class="cine-hero__title animate-fade-in-up animate-delay-1">
            El modo más completo<br />
            <em>de mentir sobre la verdad.</em>
          </h1>
          <p class="cine-hero__sub animate-fade-in-up animate-delay-2">
            No creo en la objetividad de la cámara. Creo en el punto de vista.
            En que cada corte es una interpretación del mundo.
          </p>
        </div>
      </div>
    </section>

    <!-- FILMS -->
    <section class="cine-films">
      <div class="container">
        <p class="cine-eyebrow">Filmografía</p>

        {films.map((film, i) => (
          <article class:list={['cine-film', { 'cine-film--reverse': i % 2 !== 0 }]}>

            <!-- Thumbnail / play -->
            <a
              href={film.youtube}
              target="_blank"
              rel="noopener noreferrer"
              class="cine-film__thumb"
              aria-label={`Ver ${film.title} en YouTube`}
            >
              <img
                src={film.thumbnail}
                alt={film.title}
                class="cine-film__img"
                loading="lazy"
              />
              <div class="cine-film__play">
                <svg viewBox="0 0 24 24" fill="currentColor" width="32" height="32" aria-hidden="true">
                  <path d="M8 5v14l11-7z"/>
                </svg>
              </div>
            </a>

            <!-- Info -->
            <div class="cine-film__info">
              <div class="cine-film__meta">
                <span class="cine-film__year">{film.year}</span>
                <span class="cine-film__format">{film.format}</span>
              </div>
              <h2 class="cine-film__title">{film.title}</h2>
              <p class="cine-film__synopsis">{film.synopsis}</p>
              <div class="cine-film__actions">
                <a
                  href={film.youtube}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="cine-film__btn cine-film__btn--primary"
                >
                  ▶ Ver cortometraje
                </a>
                <a href={`/${film.slug}`} class="cine-film__btn cine-film__btn--ghost">
                  Ficha técnica →
                </a>
              </div>
            </div>

          </article>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <section class="cine-cta">
      <div class="container container--narrow">
        <div class="cine-cta__inner">
          <p class="cine-cta__text">¿Una idea, una propuesta, una colaboración?</p>
          <a href="/hablemos" class="cine-cta__link">Hablemos →</a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>

<style>
  /* ---- Hero ---- */
  .cine-hero {
    position: relative;
    background-color: var(--ink);
    padding-top: var(--header-height);
    min-height: 70vh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }

  .cine-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom right,
      rgba(155, 32, 32, 0.07) 0%,
      transparent 60%
    );
    pointer-events: none;
  }

  .cine-hero__content {
    position: relative;
    padding-bottom: var(--space-20);
    padding-top: var(--space-16);
  }

  .cine-hero__eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--blood-light);
    margin-bottom: var(--space-5);
  }

  .cine-hero__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 4.5rem);
    font-weight: 400;
    line-height: 1.15;
    color: var(--text-on-dark);
    max-width: 700px;
    margin-bottom: var(--space-6);
  }

  .cine-hero__sub {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-style: italic;
    color: var(--text-on-dark-muted);
    max-width: 520px;
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  /* ---- Films ---- */
  .cine-films {
    background-color: var(--cream);
    padding: var(--space-20) 0 var(--space-24);
  }

  .cine-eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--stone);
    margin-bottom: var(--space-16);
  }

  .cine-film {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-16);
    align-items: center;
    padding: var(--space-16) 0;
    border-top: 1px solid var(--fog);
  }

  .cine-film:last-child {
    border-bottom: 1px solid var(--fog);
  }

  .cine-film--reverse {
    direction: rtl;
  }

  .cine-film--reverse > * {
    direction: ltr;
  }

  /* Thumbnail */
  .cine-film__thumb {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background-color: var(--ink);
  }

  .cine-film__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
    filter: brightness(0.85);
  }

  .cine-film__thumb:hover .cine-film__img {
    transform: scale(1.04);
    filter: brightness(0.7);
  }

  .cine-film__play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--cream);
    opacity: 0;
    transition: opacity var(--transition-base);
  }

  .cine-film__play svg {
    width: 56px;
    height: 56px;
    filter: drop-shadow(0 2px 12px rgba(0,0,0,0.6));
  }

  .cine-film__thumb:hover .cine-film__play {
    opacity: 1;
  }

  /* Info */
  .cine-film__meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .cine-film__year {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--stone);
  }

  .cine-film__format {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--blood);
    padding: 2px var(--space-2);
    border: 1px solid rgba(155, 32, 32, 0.3);
  }

  .cine-film__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: 400;
    font-style: italic;
    color: var(--ink);
    margin-bottom: var(--space-5);
    line-height: 1.1;
  }

  .cine-film__synopsis {
    font-size: var(--text-base);
    color: var(--stone);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-8);
  }

  .cine-film__actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .cine-film__btn {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    padding: var(--space-3) var(--space-6);
    transition: all var(--transition-fast);
    white-space: nowrap;
  }

  .cine-film__btn--primary {
    background-color: var(--blood);
    color: var(--cream);
    border: 1px solid var(--blood);
  }

  .cine-film__btn--primary:hover {
    background-color: var(--blood-hover);
    border-color: var(--blood-hover);
  }

  .cine-film__btn--ghost {
    background-color: transparent;
    color: var(--ink);
    border: 1px solid var(--fog);
  }

  .cine-film__btn--ghost:hover {
    border-color: var(--ink);
  }

  /* ---- CTA ---- */
  .cine-cta {
    background-color: var(--ink);
    padding: var(--space-16) 0;
  }

  .cine-cta__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
    flex-wrap: wrap;
  }

  .cine-cta__text {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    font-style: italic;
    color: var(--text-on-dark-muted);
    margin: 0;
  }

  .cine-cta__link {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-on-dark);
    text-decoration: none;
    border-bottom: 1px solid rgba(240, 235, 227, 0.3);
    padding-bottom: 2px;
    white-space: nowrap;
    transition: color var(--transition-fast), border-color var(--transition-fast);
  }

  .cine-cta__link:hover {
    color: var(--fog-light);
    border-bottom-color: var(--fog-light);
  }

  /* ---- Responsive ---- */
  @media (max-width: 900px) {
    .cine-film {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }

    .cine-film--reverse {
      direction: ltr;
    }
  }

  @media (max-width: 600px) {
    .cine-cta__inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
