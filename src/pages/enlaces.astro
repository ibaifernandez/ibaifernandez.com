  {
    label: 'AGLAYA · Nomad Marketing',
    desc:  'Mi agencia. De algo hay que ganarse la vida.',
    href:  'https://aglaya.biz/',
    external: true,
  },
  {
    label: 'Portafolio Full-Stack',
    desc:  'También desarrollo. Especialidad en front-end con sólidos conocimientos de back-end.',
