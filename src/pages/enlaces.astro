---

<BaseLayout
  title="Ibai Fernández — Links"
  description="Todo lo que hace Ibai Fernández en un solo lugar: escritura, fotografía, audiovisual, desarrollo y más."
>

  <main class="links-page">

    <!-- Profile -->
    <header class="links-profile">
      <div class="links-profile__avatar">
        <img
          src="/images/wp-archive/ibai-fernandez-2023.jpeg"
          alt="Ibai Fernández"
          width="80"
          height="80"
        />
      </div>
      <h1 class="links-profile__name">Ibai Fernández</h1>
      <p class="links-profile__bio">
        Escritor · Fotógrafo · Realizador · Nómada digital
      </p>
    </header>

    <!-- Link list -->
    <nav class="links-list" aria-label="Links de Ibai Fernández">
      {links.map((link) => (
        <a
          href={link.href}
          class="links-item"
          {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        >
          <span class="links-item__label">{link.label}</span>
          <span class="links-item__desc">{link.desc}</span>
          {link.external && (
            <svg class="links-item__ext" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
              <polyline points="15 3 21 3 21 9"/>
              <line x1="10" y1="14" x2="21" y2="3"/>
            </svg>
          )}
        </a>
      ))}
    </nav>

    <!-- Socials -->
    <div class="links-socials" aria-label="Redes sociales">
      {socials.map((s) => (
        <a
          href={s.href}
          class="links-social__btn"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={s.label}
          title={s.label}
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d={s.path} />
          </svg>
        </a>
      ))}
    </div>

    <!-- Footer -->
    <p class="links-footer">
      <a href="/" class="links-footer__home">ibaifernandez.com</a>
    </p>

  </main>

</BaseLayout>

<style>
  /* ─── Page shell ─────────────────────────────────────────────── */
  .links-page {
    min-height: 100vh;
    background-color: var(--ink);
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: var(--space-10) var(--space-5) var(--space-16);
    /* Subtle texture via repeating gradient */
    background-image: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 2px,
      rgba(255,255,255,0.015) 2px,
      rgba(255,255,255,0.015) 4px
    );
  }

  /* ─── Profile ────────────────────────────────────────────────── */
  .links-profile {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-bottom: var(--space-10);
    width: 100%;
    max-width: 480px;
  }

  .links-profile__avatar {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid var(--blood);
    margin-bottom: var(--space-4);
    flex-shrink: 0;
  }

  .links-profile__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    display: block;
  }

  .links-profile__name {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 400;
    color: var(--cream);
    margin-bottom: var(--space-2);
    letter-spacing: -0.01em;
  }

  .links-profile__bio {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--text-on-dark-muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-weight: 500;
    margin: 0;
  }

  /* ─── Link list ──────────────────────────────────────────────── */
  .links-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    width: 100%;
    max-width: 480px;
    margin-bottom: var(--space-10);
  }

  .links-item {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4) var(--space-5);
    background-color: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.1);
    text-decoration: none;
    transition:
      background-color 0.18s ease,
      border-color 0.18s ease,
      transform 0.18s ease;
    /* keep ext icon in corner */
  }

  .links-item:hover {
    background-color: rgba(255,255,255,0.11);
    border-color: var(--blood);
    transform: translateY(-1px);
  }

  .links-item__label {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 500;
    color: var(--cream);
    line-height: 1.2;
  }

  .links-item__desc {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--text-on-dark-muted);
    line-height: 1.5;
  }

  .links-item__ext {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    color: rgba(255,255,255,0.25);
    flex-shrink: 0;
  }

  /* ─── Socials ────────────────────────────────────────────────── */
  .links-socials {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    width: 100%;
    max-width: 480px;
    margin-bottom: var(--space-10);
  }

  .links-social__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    color: rgba(255,255,255,0.45);
    border: 1px solid rgba(255,255,255,0.12);
    text-decoration: none;
    border-radius: 50%;
    transition: color 0.18s ease, border-color 0.18s ease, background-color 0.18s ease;
  }

  .links-social__btn:hover {
    color: var(--cream);
    border-color: var(--blood);
    background-color: rgba(155,32,32,0.2);
  }

  /* ─── Footer ─────────────────────────────────────────────────── */
  .links-footer {
    margin: 0;
  }

  .links-footer__home {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.2);
    text-decoration: none;
    transition: color 0.18s ease;
  }

  .links-footer__home:hover {
    color: rgba(255,255,255,0.5);
  }

  /* ─── Mobile tweaks (already mobile-first, just fine-tune) ────── */
  @media (max-width: 520px) {
    .links-page {
      padding-top: var(--space-8);
    }
  }
</style>
