---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BlogCard from '../components/BlogCard.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Build list of series (using series field if present, else category)
const seriesSet = new Set<string>();
allPosts.forEach((p) => {
  const s = (p.data as any).series;
  if (s) seriesSet.add(s);
});
const seriesList = Array.from(seriesSet);
---

<BaseLayout
  title="Artículos"
  description="Ensayos, filosofía, escritura, compatibilidad y vida extraordinaria. Todos los artículos de Ibai Fernández."
>
  <Header />

  <!-- HERO -->
  <section class="articles-hero section--dark" style="padding-top: var(--header-height);">
    <div class="container">
      <p class="articles-hero__eyebrow animate-fade-in">Escritura</p>
      <h1 class="articles-hero__title animate-fade-in-up animate-delay-1">
        Artículos
      </h1>
      <p class="articles-hero__sub animate-fade-in-up animate-delay-2">
        {allPosts.length} textos sobre filosofía, escritura, vida y rebeldía consciente.
      </p>
    </div>
  </section>

  <!-- SERIES FILTERS + GRID -->
  <section class="articles-body section--paper">
    <div class="container">

      {seriesList.length > 0 && (
        <div class="series-filters" id="series-filters">
          <button class="series-filter is-active" data-series="all">Todos</button>
          {seriesList.map((s) => (
            <button class="series-filter" data-series={s}>{s}</button>
          ))}
        </div>
      )}

      {allPosts.length > 0 ? (
        <div class="articles-grid" id="articles-grid">
          {allPosts.map((post) => {
            const series = (post.data as any).series;
            return (
              <div class="article-item" data-series={series || ''}>
                <BlogCard
                  title={post.data.title}
                  description={post.data.description}
                  pubDate={post.data.pubDate}
                  heroImage={post.data.heroImage}
                  category={post.data.category}
                  series={series}
                  slug={post.id}
                />
              </div>
            );
          })}
        </div>
      ) : (
        <p class="articles-empty">Aún no hay artículos publicados. ¡Muy pronto!</p>
      )}

    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  /* Hero */
  .articles-hero {
    padding: var(--space-24) 0 var(--space-16);
  }

  .articles-hero__eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--blood-light);
    margin-bottom: var(--space-4);
  }

  .articles-hero__title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 6vw, 5rem);
    font-weight: 400;
    font-style: italic;
    color: var(--text-on-dark);
    margin-bottom: var(--space-4);
    line-height: 1.05;
  }

  .articles-hero__sub {
    font-size: var(--text-lg);
    color: var(--text-on-dark-muted);
    margin: 0;
  }

  /* Body */
  .articles-body {
    padding: var(--space-16) 0 var(--space-24);
  }

  /* Series filters */
  .series-filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-12);
  }

  .series-filter {
    padding: var(--space-2) var(--space-5);
    border: 1px solid var(--fog);
    background: transparent;
    color: var(--text-secondary);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0.02em;
    cursor: pointer;
    transition: all var(--transition-base);
    border-radius: 0;
  }

  .series-filter:hover {
    border-color: var(--stone);
    color: var(--text-ink);
  }

  .series-filter.is-active {
    background-color: var(--blood);
    border-color: var(--blood);
    color: var(--cream);
  }

  /* Grid */
  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--space-6);
  }

  .article-item {
    transition: opacity var(--transition-base);
  }

  .article-item.is-hidden {
    display: none;
  }

  .articles-empty {
    text-align: center;
    padding: var(--space-20);
    color: var(--text-muted);
    font-size: var(--text-xl);
    font-style: italic;
    font-family: var(--font-display);
  }

  @media (max-width: 768px) {
    .articles-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const filters = document.querySelectorAll<HTMLButtonElement>('.series-filter');
  const items   = document.querySelectorAll<HTMLElement>('.article-item');

  filters.forEach((filter) => {
    filter.addEventListener('click', () => {
      filters.forEach((f) => f.classList.remove('is-active'));
      filter.classList.add('is-active');

      const series = filter.getAttribute('data-series');

      items.forEach((item) => {
        const itemSeries = item.getAttribute('data-series') || '';
        const show = series === 'all' || itemSeries === series;
        item.classList.toggle('is-hidden', !show);
      });
    });
  });
</script>
