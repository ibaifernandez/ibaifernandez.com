---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<BaseLayout
  title="Contacto"
  description="¿Quieres ponerte en contacto con Ibai Fernández? Escríbeme y conversemos."
>
  <Header />

  <!-- HERO -->
  <section class="page-hero section--dark" style="padding-top: var(--header-height);">
    <div class="container">
      <h1 class="page-hero__title animate-fade-in-up">¿Conversamos?</h1>
      <p class="page-hero__subtitle animate-fade-in-up animate-delay-1">
        Si tienes algo que contarme, me encantaría escucharte.
      </p>
    </div>
  </section>

  <!-- CONTACT FORM -->
  <section class="section section--white">
    <div class="container container--narrow">
      <form
        class="contact-form"
        name="contact"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        id="contact-form"
      >
        <!-- Honeypot field for spam prevention -->
        <p class="sr-only">
          <label>No rellenar si eres humano: <input name="bot-field" /></label>
        </p>

        <div class="form-group">
          <label for="name" class="form-label">Nombre</label>
          <input
            type="text"
            id="name"
            name="name"
            required
            class="form-input"
            placeholder="Tu nombre"
          />
        </div>

        <div class="form-group">
          <label for="email" class="form-label">Email</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            class="form-input"
            placeholder="tu@email.com"
          />
        </div>

        <div class="form-group">
          <label for="subject" class="form-label">Asunto</label>
          <input
            type="text"
            id="subject"
            name="subject"
            class="form-input"
            placeholder="¿De qué quieres hablar?"
          />
        </div>

        <div class="form-group">
          <label for="message" class="form-label">Mensaje</label>
          <textarea
            id="message"
            name="message"
            required
            rows="6"
            class="form-input form-textarea"
            placeholder="Escribe tu mensaje aquí..."
          ></textarea>
        </div>

        <div class="form-group turnstile-container">
          <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="light"></div>
        </div>

        <button type="submit" class="btn btn--primary btn--lg form-submit">
          Enviar mensaje
        </button>
      </form>
    </div>
  </section>

  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

  <Footer />
</BaseLayout>

<style>
  .page-hero {
    padding: var(--space-24) 0 var(--space-16);
    text-align: center;
  }

  .page-hero__title {
    font-family: var(--font-display);
    font-size: var(--text-5xl);
    color: var(--color-text-on-dark);
    font-weight: 700;
    margin-bottom: var(--space-4);
  }

  .page-hero__subtitle {
    font-size: var(--text-xl);
    color: var(--color-text-on-dark-muted);
    max-width: 500px;
    margin: 0 auto;
  }

  .contact-form {
    max-width: 600px;
    margin: 0 auto;
  }

  .form-group {
    margin-bottom: var(--space-6);
  }

  .turnstile-container {
    display: flex;
    justify-content: center;
    margin-top: var(--space-4);
    margin-bottom: var(--space-8);
  }

  .form-label {
    display: block;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-primary);
    margin-bottom: var(--space-2);
  }

  .form-input {
    width: 100%;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background-color: var(--color-bg-light);
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--color-text-primary);
    transition: all var(--transition-fast);
  }

  .form-input::placeholder {
    color: var(--color-text-muted);
  }

  .form-input:focus {
    outline: none;
    border-color: var(--color-accent-secondary);
    box-shadow: 0 0 0 3px rgba(14, 165, 233, 0.12);
    background-color: var(--color-bg-white);
  }

  .form-textarea {
    resize: vertical;
    min-height: 150px;
  }

  .form-submit {
    width: 100%;
    justify-content: center;
    margin-top: var(--space-2);
  }

  @media (max-width: 768px) {
    .page-hero__title {
      font-size: var(--text-3xl);
    }
  }
</style>
