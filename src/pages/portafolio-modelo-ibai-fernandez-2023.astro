---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const heroImage = '/images/portafolio-modelo/Ibai-Fernandez-Modelaje-Iris-Model-Agency-Photobook-Traje-BN-3.jpg';

const series = [
  {
    num:    'I',
    label:  'Elegancia atemporal y sofisticación',
    photos: [
      '/images/portafolio-modelo/Ibai-Fernandez-Modelaje-Iris-Model-Agency-Photobook-Traje-BN-3.jpg',
      '/images/portafolio-modelo/Ibai-Fernandez-Modelaje-Iris-Model-Agency-Photobook-Traje-Color-1.jpg',
    ],
  },
  {
    num:    'II',
    label:  'Encanto y estilo con un toque rústico',
    photos: [
      '/images/portafolio-modelo/Ibai-Fernandez-Modelaje-Iris-Model-Agency-Photobook-Cazadora-cafe-BN-40.jpg',
      '/images/portafolio-modelo/Ibai-Fernandez-Modelaje-Iris-Model-Agency-Photobook-Cazadora-cafe-Color-3.jpg',
    ],
  },
  {
    num:    'III',
    label:  'Vibrando al ritmo del Rock \'n\' Roll',
    photos: [
      '/images/portafolio-modelo/Ibai-Fernandez-Modelaje-Iris-Model-Agency-Photobook-Cazadora-negra-BN-5.jpg',
      '/images/portafolio-modelo/Ibai-Fernandez-Modelaje-Iris-Model-Agency-Photobook-Cazadora-negra-Color-4.jpg',
    ],
  },
  {
    num:    'IV',
    label:  'Espíritu grunge, actitud rebelde',
    photos: [
      '/images/portafolio-modelo/Ibai-Fernandez-Modelaje-Iris-Model-Agency-Photobook-Grunge-BN-11.jpg',
      '/images/portafolio-modelo/Ibai-Fernandez-Modelaje-Iris-Model-Agency-Photobook-Grunge-Color-2.jpg',
    ],
  },
  {
    num:    'V',
    label:  'Espontáneo, libertino, cautivador',
    photos: [
      '/images/portafolio-modelo/Ibai-Fernandez-Modelaje-Domestico-Photobook-Grunge-Descubierto.jpg',
      '/images/portafolio-modelo/Ibai-Fernandez-Modelaje-Iris-Model-Agency-Photobook-Camiseta-gris-1.jpg',
      '/images/portafolio-modelo/Ibai-Fernandez-Modelaje-Iris-Model-Agency-Photobook-Camiseta-gris-2.jpg',
    ],
  },
];
---

<BaseLayout
  title="Portafolio Modelo · Ibai Fernández"
  description="Descubre la pasión y versatilidad de Ibai Fernández como modelo a través de su portafolio fotográfico 2023 con Iris Model Agency, Bogotá."
  ogImage={heroImage}
>
  <Header />

  <main id="main-content">

    <!-- HERO -->
    <section class="model-hero" style={`--hero-img: url('${heroImage}')`}>
      <div class="model-hero__bg"></div>
      <div class="model-hero__overlay"></div>
      <div class="container">
        <div class="model-hero__content">
          <p class="model-hero__eyebrow animate-fade-in">Modelaje · 2023</p>
          <h1 class="model-hero__title animate-fade-in-up animate-delay-1">Portafolio</h1>
          <p class="model-hero__sub animate-fade-in-up animate-delay-2">
            Iris Model Agency · Bogotá, Colombia
          </p>
        </div>
      </div>
    </section>

    <!-- INTRO -->
    <section class="model-intro">
      <div class="container container--narrow">
        <p class="model-intro__text">
          Cada imagen captura la esencia de una dedicación al arte del modelaje:
          una variedad de estilos y expresiones que reflejan personalidad en cada toma.
        </p>
      </div>
    </section>

    <!-- SERIES -->
    <section class="model-series">
      <div class="container">
        {series.map((s, si) => (
          <div class="model-serie">
            <div class="model-serie__header">
              <span class="model-serie__num">{s.num}</span>
              <h2 class="model-serie__label">{s.label}</h2>
            </div>
            <div class:list={['model-grid', { 'model-grid--three': s.photos.length === 3 }]}>
              {s.photos.map((src, pi) => (
                <div class="model-photo">
                  <img
                    src={src}
                    alt={`${s.label} · ${pi + 1}`}
                    loading={si === 0 && pi === 0 ? 'eager' : 'lazy'}
                  />
                </div>
              ))}
            </div>
            {si < series.length - 1 && <div class="model-divider"></div>}
          </div>
        ))}
      </div>
    </section>

    <!-- BOOKING CTA -->
    <section class="model-booking">
      <div class="container container--narrow">
        <div class="model-booking__inner">
          <div>
            <p class="model-booking__label">Contrataciones</p>
            <a href="https://www.instagram.com/ibaifernandezec/" target="_blank" rel="noopener noreferrer" class="model-booking__link">
              @ibaifernandezec →
            </a>
          </div>
          <div class="model-booking__agency">
            <p class="model-booking__label">Agencia</p>
            <p class="model-booking__agency-name">Iris Model Agency · Bogotá</p>
          </div>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>

<style>
  /* ---- Hero ---- */
  .model-hero {
    position: relative;
    min-height: 85vh;
    display: flex;
    align-items: flex-end;
    padding-top: var(--header-height);
    overflow: hidden;
  }

  .model-hero__bg {
    position: absolute;
    inset: 0;
    background-image: var(--hero-img);
    background-size: cover;
    background-position: center 20%;
    filter: brightness(0.5);
  }

  .model-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 30%, rgba(14,12,10,0.9) 100%);
  }

  .model-hero__content {
    position: relative;
    z-index: 1;
    padding-bottom: var(--space-20);
    padding-top: var(--space-16);
  }

  .model-hero__eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--blood-light);
    margin-bottom: var(--space-4);
  }

  .model-hero__title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 8vw, 7rem);
    font-weight: 300;
    font-style: italic;
    color: var(--text-on-dark);
    line-height: 1;
    margin-bottom: var(--space-4);
  }

  .model-hero__sub {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-on-dark-muted);
    margin: 0;
  }

  /* ---- Intro ---- */
  .model-intro {
    background-color: var(--ink);
    padding: var(--space-16) 0;
    border-bottom: 1px solid rgba(240,235,227,0.08);
  }

  .model-intro__text {
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2.5vw, 1.5rem);
    font-style: italic;
    font-weight: 400;
    color: var(--text-on-dark-muted);
    line-height: 1.7;
    text-align: center;
    margin: 0;
  }

  /* ---- Series ---- */
  .model-series {
    background-color: var(--ink);
    padding: var(--space-16) 0 var(--space-24);
  }

  .model-serie {
    padding: var(--space-12) 0;
  }

  .model-serie__header {
    display: flex;
    align-items: baseline;
    gap: var(--space-6);
    margin-bottom: var(--space-8);
  }

  .model-serie__num {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 4vw, 4rem);
    font-weight: 300;
    color: rgba(240,235,227,0.15);
    line-height: 1;
    flex-shrink: 0;
  }

  .model-serie__label {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2vw, 1.5rem);
    font-weight: 400;
    font-style: italic;
    color: var(--text-on-dark-muted);
    margin: 0;
  }

  /* ---- Photo grid ---- */
  .model-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 4px;
  }

  .model-grid--three {
    grid-template-columns: repeat(3, 1fr);
  }

  .model-photo {
    overflow: hidden;
    aspect-ratio: 2 / 3;
    background-color: rgba(240,235,227,0.04);
  }

  .model-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
    transition: transform 0.6s ease, filter 0.4s ease;
    filter: brightness(0.9);
  }

  .model-photo:hover img {
    transform: scale(1.04);
    filter: brightness(1);
  }

  .model-divider {
    border: none;
    border-top: 1px solid rgba(240,235,227,0.08);
    margin-top: var(--space-12);
  }

  /* ---- Booking ---- */
  .model-booking {
    background-color: var(--ink);
    border-top: 1px solid rgba(240,235,227,0.1);
    padding: var(--space-16) 0;
  }

  .model-booking__inner {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-10);
    flex-wrap: wrap;
  }

  .model-booking__label {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--stone);
    margin-bottom: var(--space-3);
  }

  .model-booking__link {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    font-style: italic;
    color: var(--text-on-dark);
    text-decoration: none;
    border-bottom: 1px solid rgba(240,235,227,0.25);
    padding-bottom: 2px;
    transition: color var(--transition-fast), border-color var(--transition-fast);
  }

  .model-booking__link:hover {
    color: var(--fog-light);
    border-bottom-color: var(--fog-light);
  }

  .model-booking__agency-name {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-style: italic;
    color: var(--text-on-dark-muted);
    margin: 0;
  }

  /* ---- Responsive ---- */
  @media (max-width: 768px) {
    .model-grid--three {
      grid-template-columns: repeat(2, 1fr);
    }
    .model-grid--three .model-photo:last-child {
      grid-column: 1 / -1;
      aspect-ratio: 3 / 2;
    }
    .model-grid--three .model-photo:last-child img {
      object-position: center center;
    }
  }

  @media (max-width: 480px) {
    .model-grid,
    .model-grid--three {
      grid-template-columns: 1fr;
    }
    .model-grid--three .model-photo:last-child {
      grid-column: auto;
      aspect-ratio: 2 / 3;
    }
    .model-booking__inner {
      flex-direction: column;
    }
  }
</style>
