---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const categories = [
  {
    num:   'I',
    title: 'Ciudades & Destinos',
    desc:  'El bullicio de las ciudades. La magia de los lugares que he tenido el privilegio de fotografiar a lo largo de los años.',
    galleries: [
      { href: '/malaga',                    label: 'Málaga',                   cover: '/images/galleries/malaga.jpg' },
      { href: '/madrid',                    label: 'Madrid',                   cover: '/images/galleries/madrid.jpg' },
      { href: '/cadiz',                     label: 'Cádiz',                    cover: '/images/galleries/cadiz.jpg' },
      { href: '/barcelona',                 label: 'Barcelona',                cover: '/images/galleries/barcelona.jpg' },
      { href: '/dublin',                    label: 'Dublín',                   cover: '/images/galleries/dublin.jpg' },
      { href: '/new-york-city',             label: 'New York City',            cover: '/images/galleries/new-york.jpg' },
      { href: '/new-hampshire-usa',         label: 'New Hampshire, USA',       cover: '/images/galleries/new-hampshire.jpg' },
      { href: '/mid-west-south-south-east', label: 'Mid West, South & SE',    cover: '/images/galleries/mid-west.jpg' },
      { href: '/salinas-ecuador-2022',      label: 'Salinas, Ecuador 2022',    cover: '/images/galleries/salinas.jpg' },
    ],
  },
  {
    num:   'II',
    title: 'Retratos, personas y personajes',
    desc:  'Retratos que capturan la esencia y la singularidad de las personas que han cruzado mi camino.',
    galleries: [
      { href: '/antonella-moreno',                    label: 'Antonella Moreno',       cover: '/images/galleries/antonella.jpg' },
      { href: '/mr-soriver',                          label: 'Mr. Soriver',             cover: '/images/galleries/mr-soriver.jpg' },
      { href: '/an-american-graduation',              label: 'An American Graduation',  cover: '/images/galleries/american-graduation.jpg' },
      { href: '/leon-el-gato',                        label: 'León el gato',            cover: '/images/galleries/leon.jpg' },
      { href: '/portafolio-modelo-ibai-fernandez-2023', label: 'Portafolio Modelo · 2023', cover: '/images/galleries/portafolio-modelo.jpg' },
    ],
  },
  {
    num:   'III',
    title: 'Reportajes',
    desc:  'Eventos, celebraciones y situaciones significativas documentadas con la cámara.',
    galleries: [
      { href: '/movimiento-15-m',      label: 'Movimiento 15-M',      cover: '/images/galleries/15m.jpg' },
      { href: '/nobiemvre',            label: 'Nobiemvre',            cover: '/images/galleries/nobiemvre.jpg' },
      { href: '/an-american-graduation', label: 'An American Graduation', cover: '/images/galleries/american-graduation.jpg' },
    ],
  },
];
---

<BaseLayout
  title="Fotografía — Ibai Fernández"
  description="Ciudades, retratos, reportajes. Una mirada que busca la tensión antes del instante perfecto."
>
  <Header />

  <main id="main-content">

    <!-- HERO -->
    <section class="foto-hero">
      <div class="foto-hero__overlay"></div>
      <div class="container">
        <div class="foto-hero__content">
          <p class="foto-hero__eyebrow animate-fade-in">Fotografía</p>
          <h1 class="foto-hero__title animate-fade-in-up animate-delay-1">
            Lo que la cámara<br />
            <em>no</em> decide.
          </h1>
          <p class="foto-hero__sub animate-fade-in-up animate-delay-2">
            Fotografío personas, ciudades y los momentos que suceden justo antes
            o después de que pase algo importante.
          </p>
        </div>
      </div>
    </section>

    <!-- GALLERIES -->
    <section class="foto-galleries">
      <div class="container">

        {categories.map((cat, ci) => (
          <div class="foto-category">

            <div class="foto-category__header">
              <span class="foto-category__num">{cat.num}</span>
              <div>
                <h2 class="foto-category__title">{cat.title}</h2>
                <p class="foto-category__desc">{cat.desc}</p>
              </div>
            </div>

            <div class="foto-grid">
              {cat.galleries.map(g => (
                <a href={g.href} class="foto-card">
                  <div class="foto-card__img" style={`background-image: url('${g.cover}')`}></div>
                  <div class="foto-card__overlay"></div>
                  <p class="foto-card__label">{g.label}</p>
                </a>
              ))}
            </div>

            {ci < categories.length - 1 && <div class="foto-divider"></div>}
          </div>
        ))}

      </div>
    </section>

    <!-- CTA -->
    <section class="foto-cta">
      <div class="container container--narrow">
        <div class="foto-cta__inner">
          <p class="foto-cta__text">¿Un proyecto fotográfico o de vídeo?</p>
          <a href="/hablemos" class="foto-cta__link">Cuéntame →</a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>

<style>
  /* ---- Hero ---- */
  .foto-hero {
    position: relative;
    background-color: var(--ink);
    padding-top: var(--header-height);
    min-height: 70vh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }

  .foto-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(155,32,32,0.08) 0%, transparent 50%);
    pointer-events: none;
  }

  .foto-hero__content {
    position: relative;
    padding-bottom: var(--space-20);
    padding-top: var(--space-16);
  }

  .foto-hero__eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--blood-light);
    margin-bottom: var(--space-5);
  }

  .foto-hero__title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 5.5rem);
    font-weight: 400;
    line-height: 1.1;
    color: var(--text-on-dark);
    margin-bottom: var(--space-8);
  }

  .foto-hero__sub {
    font-size: var(--text-lg);
    color: var(--text-on-dark-muted);
    max-width: 520px;
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  /* ---- Galleries ---- */
  .foto-galleries {
    background-color: var(--cream);
    padding: var(--space-20) 0 var(--space-24);
  }

  .foto-category {
    padding: var(--space-12) 0;
  }

  .foto-category__header {
    display: flex;
    gap: var(--space-8);
    align-items: flex-start;
    margin-bottom: var(--space-10);
  }

  .foto-category__num {
    font-family: var(--font-display);
    font-size: clamp(3rem, 5vw, 5rem);
    font-weight: 300;
    color: var(--fog);
    line-height: 1;
    flex-shrink: 0;
    width: 4rem;
  }

  .foto-category__title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 500;
    font-style: italic;
    color: var(--ink);
    margin-bottom: var(--space-3);
  }

  .foto-category__desc {
    font-size: var(--text-base);
    color: var(--stone);
    line-height: var(--leading-relaxed);
    max-width: 520px;
    margin: 0;
  }

  /* ---- Card grid ---- */
  .foto-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
  }

  .foto-card {
    position: relative;
    display: block;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    text-decoration: none;
  }

  .foto-card__img {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    transition: transform 0.55s ease;
    filter: brightness(0.75);
  }

  .foto-card__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(14,12,10,0.75) 0%, rgba(14,12,10,0.1) 60%);
    transition: background var(--transition-base);
  }

  .foto-card__label {
    position: absolute;
    bottom: var(--space-4);
    left: var(--space-5);
    right: var(--space-5);
    font-family: var(--font-display);
    font-size: clamp(1rem, 1.5vw, 1.25rem);
    font-style: italic;
    font-weight: 400;
    color: var(--text-on-dark);
    margin: 0;
    line-height: 1.2;
    transition: color var(--transition-fast);
  }

  .foto-card:hover .foto-card__img {
    transform: scale(1.05);
  }

  .foto-card:hover .foto-card__overlay {
    background: linear-gradient(to top, rgba(155,32,32,0.65) 0%, rgba(14,12,10,0.35) 100%);
  }

  .foto-divider {
    border: none;
    border-top: 1px solid var(--fog);
    margin-top: var(--space-8);
  }

  /* ---- CTA ---- */
  .foto-cta {
    background-color: var(--ink);
    padding: var(--space-16) 0;
  }

  .foto-cta__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
    flex-wrap: wrap;
  }

  .foto-cta__text {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    font-style: italic;
    color: var(--text-on-dark-muted);
    margin: 0;
  }

  .foto-cta__link {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-on-dark);
    text-decoration: none;
    border-bottom: 1px solid rgba(240,235,227,0.3);
    padding-bottom: 2px;
    white-space: nowrap;
    transition: color var(--transition-fast), border-color var(--transition-fast);
  }

  .foto-cta__link:hover {
    color: var(--fog-light);
    border-bottom-color: var(--fog-light);
  }

  /* ---- Responsive ---- */
  @media (max-width: 900px) {
    .foto-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .foto-grid {
      grid-template-columns: 1fr;
    }

    .foto-category__header {
      flex-direction: column;
      gap: var(--space-3);
    }

    .foto-cta__inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
