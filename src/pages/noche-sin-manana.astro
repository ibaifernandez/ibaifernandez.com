---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const youtubeId = 'm_G2yF4-5wQ';
const thumbnail  = `https://img.youtube.com/vi/${youtubeId}/maxresdefault.jpg`;
---

<BaseLayout
  title="Noche sin mañana — Ibai Fernández"
  description="<!-- SINOPSIS BREVE -->"
  ogImage={thumbnail}
  ogType="video.movie"
>
  <Header />

  <main id="main-content">

    <!-- HERO -->
    <section class="film-hero" style={`--hero-thumb: url('${thumbnail}')`}>
      <div class="film-hero__bg"></div>
      <div class="film-hero__overlay"></div>
      <div class="container">
        <div class="film-hero__content">
          <p class="film-hero__eyebrow">Cortometraje</p>
          <h1 class="film-hero__title">Noche sin mañana</h1>
          <p class="film-hero__year"><!-- AÑO --></p>
          <a
            href={`https://www.youtube.com/watch?v=${youtubeId}`}
            target="_blank"
            rel="noopener noreferrer"
            class="film-hero__play"
            aria-label="Ver Noche sin mañana en YouTube"
          >
            <span class="film-hero__play-icon">
              <svg viewBox="0 0 24 24" fill="currentColor" width="28" height="28" aria-hidden="true">
                <path d="M8 5v14l11-7z"/>
              </svg>
            </span>
            Ver cortometraje
          </a>
        </div>
      </div>
    </section>

    <!-- SYNOPSIS -->
    <section class="film-body">
      <div class="container container--narrow">

        <div class="film-synopsis">
          <p class="film-synopsis__lead"><!-- SINOPSIS LARGA --></p>
        </div>

        <!-- Credits -->
        <div class="film-credits">
          <h2 class="film-credits__title">Ficha técnica</h2>
          <table class="film-credits__table">
            <tbody>
              <tr>
                <th>Dirección</th>
                <td>Ibai Fernández</td>
              </tr>
              <tr>
                <th>Guión</th>
                <td><!-- GUIONISTA --></td>
              </tr>
              <tr>
                <th>Año</th>
                <td><!-- AÑO --></td>
              </tr>
              <tr>
                <th>Formato</th>
                <td>Cortometraje</td>
              </tr>
              <tr>
                <th>Duración</th>
                <td><!-- DURACIÓN --></td>
              </tr>
            </tbody>
          </table>
        </div>

      </div>
    </section>

    <!-- CTA -->
    <section class="film-cta">
      <div class="container container--narrow">
        <div class="film-cta__inner">
          <p class="film-cta__text">¿Una idea, una propuesta, una colaboración?</p>
          <a href="/hablemos" class="film-cta__link">Hablemos →</a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>

<style>
  /* Hero */
  .film-hero {
    position: relative;
    min-height: 80vh;
    display: flex;
    align-items: flex-end;
    padding-top: var(--header-height);
    overflow: hidden;
  }

  .film-hero__bg {
    position: absolute;
    inset: 0;
    background-image: var(--hero-thumb);
    background-size: cover;
    background-position: center;
    filter: brightness(0.55);
  }

  .film-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      transparent 30%,
      rgba(14, 12, 10, 0.85) 100%
    );
  }

  .film-hero__content {
    position: relative;
    z-index: 1;
    padding-bottom: var(--space-20);
    padding-top: var(--space-16);
  }

  .film-hero__eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--blood-light);
    margin-bottom: var(--space-4);
  }

  .film-hero__title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 5rem);
    font-weight: 400;
    font-style: italic;
    color: var(--text-on-dark);
    line-height: 1.1;
    margin-bottom: var(--space-3);
  }

  .film-hero__year {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--text-on-dark-muted);
    margin-bottom: var(--space-8);
  }

  .film-hero__play {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--cream);
    text-decoration: none;
    background-color: var(--blood);
    border: 1px solid var(--blood);
    padding: var(--space-3) var(--space-6);
    transition: background-color var(--transition-fast), border-color var(--transition-fast);
  }

  .film-hero__play:hover {
    background-color: var(--blood-hover);
    border-color: var(--blood-hover);
  }

  /* Body */
  .film-body {
    background-color: var(--cream);
    padding: var(--space-20) 0;
  }

  .film-synopsis {
    margin-bottom: var(--space-16);
    padding-bottom: var(--space-16);
    border-bottom: 1px solid var(--fog);
  }

  .film-synopsis__lead {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2.5vw, 1.6rem);
    font-style: italic;
    font-weight: 400;
    color: var(--ink);
    line-height: 1.65;
    margin: 0;
  }

  /* Credits */
  .film-credits__title {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--stone);
    margin-bottom: var(--space-6);
  }

  .film-credits__table {
    width: 100%;
    border-collapse: collapse;
  }

  .film-credits__table tr {
    border-bottom: 1px solid var(--fog);
  }

  .film-credits__table th,
  .film-credits__table td {
    padding: var(--space-3) var(--space-4);
    font-size: var(--text-sm);
    text-align: left;
  }

  .film-credits__table th {
    font-family: var(--font-body);
    font-weight: 600;
    color: var(--stone);
    width: 160px;
    padding-left: 0;
  }

  .film-credits__table td {
    font-family: var(--font-display);
    font-style: italic;
    color: var(--ink);
  }

  /* CTA */
  .film-cta {
    background-color: var(--ink);
    padding: var(--space-16) 0;
  }

  .film-cta__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
    flex-wrap: wrap;
  }

  .film-cta__text {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    font-style: italic;
    color: var(--text-on-dark-muted);
    margin: 0;
  }

  .film-cta__link {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-on-dark);
    text-decoration: none;
    border-bottom: 1px solid rgba(240, 235, 227, 0.3);
    padding-bottom: 2px;
    white-space: nowrap;
    transition: color var(--transition-fast), border-color var(--transition-fast);
  }

  .film-cta__link:hover {
    color: var(--fog-light);
    border-bottom-color: var(--fog-light);
  }

  @media (max-width: 600px) {
    .film-cta__inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
