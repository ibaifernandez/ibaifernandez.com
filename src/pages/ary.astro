---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// Photo set — using WP archive URLs until local copies are added to /public/images/
const photos = Array.from({ length: 26 }, (_, i) => {
  const n = [12,18,16,17,20,22,23,19,9,11,2,7,5,10,3,15,21,24,13,25,6,14,4,1,26,8][i];
  return {
    src: `https://ibaifernandez.com/wp-content/uploads/2021/03/Ary-${n}.jpg`,
    alt: `Ary — fotografía ${i + 1} por Ibai Fernández`,
  };
});
---

<BaseLayout
  title="Ary — Fotografía de Ibai Fernández"
  description="Galería fotográfica de Ary, por Ibai Fernández. Una sesión de retrato en Málaga."
>
  <Header />

  <main id="main-content">

    <!-- HERO -->
    <section class="ary-hero">
      <div class="ary-hero__content container">
        <p class="ary-hero__eyebrow animate-fade-in">Fotografía · Retrato</p>
        <h1 class="ary-hero__title animate-fade-in-up animate-delay-1">
          Ary
        </h1>
        <p class="ary-hero__sub animate-fade-in-up animate-delay-2">
          Fotografía de Ibai Fernández
        </p>
      </div>
    </section>

    <!-- GALLERY -->
    <section class="ary-gallery">
      <div class="ary-grid">
        {photos.map((photo, i) => (
          <div class="ary-grid__item" data-index={i}>
            <img
              src={photo.src}
              alt={photo.alt}
              loading={i < 6 ? 'eager' : 'lazy'}
              decoding="async"
            />
          </div>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <section class="ary-cta">
      <div class="container container--narrow">
        <div class="ary-cta__inner">
          <p class="ary-cta__text">¿Te gustó lo que ves?</p>
          <a href="/fotografia" class="ary-cta__link">Ver más fotografía →</a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>

<!-- Lightbox -->
<div class="lightbox" id="lightbox" aria-hidden="true" role="dialog" aria-label="Fotografía ampliada">
  <button class="lightbox__close" id="lightbox-close" aria-label="Cerrar">×</button>
  <button class="lightbox__prev" id="lightbox-prev" aria-label="Anterior">‹</button>
  <button class="lightbox__next" id="lightbox-next" aria-label="Siguiente">›</button>
  <div class="lightbox__img-wrap">
    <img src="" alt="" id="lightbox-img" />
  </div>
</div>

<style>
  /* ── Hero ──────────────────────────────────────────────────── */
  .ary-hero {
    background-color: var(--ink);
    padding-top: var(--header-height);
    min-height: 55vh;
    display: flex;
    align-items: flex-end;
  }

  .ary-hero__content {
    padding-bottom: var(--space-16);
    padding-top: var(--space-16);
  }

  .ary-hero__eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--blood-light);
    margin-bottom: var(--space-4);
  }

  .ary-hero__title {
    font-family: var(--font-display);
    font-size: clamp(4rem, 14vw, 10rem);
    font-weight: 300;
    line-height: 0.9;
    color: var(--cream);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-4);
  }

  .ary-hero__sub {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-style: italic;
    color: var(--text-on-dark-muted);
    margin: 0;
  }

  /* ── Gallery grid ──────────────────────────────────────────── */
  .ary-gallery {
    background-color: var(--ink);
    padding: var(--space-10) 0 0;
  }

  .ary-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3px;
  }

  .ary-grid__item {
    aspect-ratio: 2/3;
    overflow: hidden;
    cursor: pointer;
    background-color: #111;
  }

  .ary-grid__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease, opacity 0.3s ease;
    border-top: none; /* override global prose img rule */
  }

  .ary-grid__item:hover img {
    transform: scale(1.04);
    opacity: 0.85;
  }

  /* ── Lightbox ──────────────────────────────────────────────── */
  .lightbox {
    position: fixed;
    inset: 0;
    background-color: rgba(0,0,0,0.93);
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }

  .lightbox.is-open {
    opacity: 1;
    pointer-events: all;
  }

  .lightbox__img-wrap {
    max-width: 90vw;
    max-height: 90vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox__img-wrap img {
    max-width: 90vw;
    max-height: 90vh;
    object-fit: contain;
    display: block;
  }

  .lightbox__close,
  .lightbox__prev,
  .lightbox__next {
    position: fixed;
    background: none;
    border: none;
    color: rgba(255,255,255,0.7);
    cursor: pointer;
    font-size: 2rem;
    line-height: 1;
    padding: var(--space-3) var(--space-5);
    transition: color 0.15s ease;
    z-index: 1001;
  }

  .lightbox__close:hover,
  .lightbox__prev:hover,
  .lightbox__next:hover {
    color: var(--cream);
  }

  .lightbox__close { top: var(--space-6); right: var(--space-6); font-size: 2.5rem; }
  .lightbox__prev  { left: var(--space-4); top: 50%; transform: translateY(-50%); font-size: 3rem; }
  .lightbox__next  { right: var(--space-4); top: 50%; transform: translateY(-50%); font-size: 3rem; }

  /* ── CTA ───────────────────────────────────────────────────── */
  .ary-cta {
    background-color: var(--ink);
    padding: var(--space-16) 0;
    border-top: 1px solid rgba(255,255,255,0.06);
  }

  .ary-cta__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
    flex-wrap: wrap;
  }

  .ary-cta__text {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2.5vw, 1.6rem);
    font-style: italic;
    color: var(--text-on-dark-muted);
    margin: 0;
  }

  .ary-cta__link {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--blood-light);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--transition-fast);
  }

  .ary-cta__link:hover { color: var(--fog-light); }

  /* ── Responsive ────────────────────────────────────────────── */
  @media (max-width: 768px) {
    .ary-grid { grid-template-columns: repeat(2, 1fr); }
    .lightbox__prev { left: var(--space-2); }
    .lightbox__next { right: var(--space-2); }
  }

  @media (max-width: 480px) {
    .ary-grid { grid-template-columns: repeat(2, 1fr); gap: 2px; }
    .ary-cta__inner { flex-direction: column; align-items: flex-start; }
  }
</style>

<script>
  // ── Lightbox ──────────────────────────────────────────────────────────────
  const items    = document.querySelectorAll<HTMLElement>('.ary-grid__item');
  const lightbox = document.getElementById('lightbox')!;
  const lbImg    = document.getElementById('lightbox-img') as HTMLImageElement;
  const lbClose  = document.getElementById('lightbox-close')!;
  const lbPrev   = document.getElementById('lightbox-prev')!;
  const lbNext   = document.getElementById('lightbox-next')!;

  let current = 0;
  const total = items.length;

  function open(index: number) {
    current = (index + total) % total;
    const img = items[current].querySelector('img') as HTMLImageElement;
    lbImg.src = img.src;
    lbImg.alt = img.alt;
    lightbox.classList.add('is-open');
    lightbox.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function close() {
    lightbox.classList.remove('is-open');
    lightbox.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  items.forEach((item, i) => {
    item.addEventListener('click', () => open(i));
    item.setAttribute('tabindex', '0');
    item.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(i); }
    });
  });

  lbClose.addEventListener('click', close);
  lbPrev.addEventListener('click', () => open(current - 1));
  lbNext.addEventListener('click', () => open(current + 1));

  lightbox.addEventListener('click', (e) => {
    if (e.target === lightbox) close();
  });

  document.addEventListener('keydown', (e) => {
    if (!lightbox.classList.contains('is-open')) return;
    if (e.key === 'Escape') close();
    if (e.key === 'ArrowLeft') open(current - 1);
    if (e.key === 'ArrowRight') open(current + 1);
  });
</script>
