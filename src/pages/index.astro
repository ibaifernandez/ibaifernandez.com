---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BlogCard from '../components/BlogCard.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import heroImage from '../assets/images/ibai-hero.png';

const recentPosts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const pillars = [
  {
    href:    '/escritura',
    label:   'Escritura',
    tagline: 'Ensayo · Ficción · Filosofía · El oficio',
    image:   '/images/wp-archive/ibai-fernandez-2023.jpeg',
  },
  {
    href:    '/fotografia',
    label:   'Fotografía',
    tagline: 'Ciudades · Retratos · Reportajes',
    image:   '/images/fotografia/new-york-1.jpg',
  },
  {
    href:    '/cine',
    label:   'Cine',
    tagline: 'Cortometrajes · The IF Show',
    image:   '/images/wp-archive/ibai-fernandez-modelaje-iris-model-agency-photobook-cazadora-cafe-bn-1.jpg',
  },
  {
    href:    '/filosofia-rebelde',
    label:   'Filosofía Rebelde',
    tagline: 'El manifiesto · La comunidad',
    image:   '/images/wp-archive/filosofia-rebelde-la-puerta-a-una-vida-extraordinaria-ibai-fernandez.jpeg',
  },
];
---

<BaseLayout
  title="Ibai Fernández"
  description="Escritor, cineasta, fotógrafo y filósofo. El mundo de Ibai Fernández."
>
  <Header />

  <main>

    <!-- =====================================================
         HERO — El Archivo del Artista
         ===================================================== -->
    <section class="home-hero">
      <div class="home-hero__bg">
        <Image
          src={heroImage}
          alt="Ibai Fernández"
          class="home-hero__portrait"
          format="webp"
          loading="eager"
        />
        <div class="home-hero__overlay"></div>
      </div>

      <div class="home-hero__content container">
        <div class="home-hero__text animate-fade-in-up">
          <p class="home-hero__eyebrow">Ibai Fernández</p>
          <h1 class="home-hero__title">
            Escritor.<br/>
            Cineasta.<br/>
            Fotógrafo.<br/>
            <em>Filósofo.</em>
          </h1>
          <div class="home-hero__divider"></div>
          <p class="home-hero__sub">
            Nómada digital · Rebelde nato · 12 años en Latinoamérica
          </p>
        </div>

        <a href="/quien-soy" class="home-hero__scroll animate-fade-in animate-delay-4">
          Conóceme
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
            <path d="M12 5v14M5 12l7 7 7-7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </section>

    <!-- =====================================================
         MANIFESTO
         ===================================================== -->
    <section class="home-manifesto section--paper">
      <div class="container container--narrow">
        <p class="home-manifesto__text animate-fade-in-up">
          Cuestiono lo establecido.<br/>
          Creo en lo extraordinario.<br/>
          Vivo para contarlo.
        </p>
        <a href="/filosofia-rebelde" class="home-manifesto__link animate-fade-in-up animate-delay-2">
          Filosofía Rebelde →
        </a>
      </div>
    </section>

    <!-- =====================================================
         PILLARS — Los mundos
         ===================================================== -->
    <section class="home-pillars section--dark">
      <div class="container">
        <h2 class="home-pillars__heading animate-fade-in-up">Los mundos</h2>
        <div class="home-pillars__grid">
          {pillars.map((pillar, i) => (
            <a
              href={pillar.href}
              class="pillar animate-fade-in-up"
              style={`animation-delay: ${i * 0.1}s; --pillar-image: url('${pillar.image}')`}
            >
              <div class="pillar__bg"></div>
              <div class="pillar__overlay"></div>
              <div class="pillar__content">
                <span class="pillar__tagline">{pillar.tagline}</span>
                <h3 class="pillar__label">{pillar.label}</h3>
                <span class="pillar__arrow">→</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- =====================================================
         RECENT ARTICLES
         ===================================================== -->
    {recentPosts.length > 0 && (
      <section class="home-articles section--cream">
        <div class="container">
          <div class="home-articles__header animate-fade-in-up">
            <h2 class="home-articles__title">Últimos artículos</h2>
            <a href="/articulos" class="home-articles__all">Ver todos →</a>
          </div>

          <div class="home-articles__grid">
            {recentPosts.map((post) => (
              <BlogCard
                title={post.data.title}
                description={post.data.description}
                pubDate={post.data.pubDate}
                heroImage={post.data.heroImage}
                category={post.data.category}
                series={post.data.series}
                slug={post.id}
              />
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- =====================================================
         NEWSLETTER
         ===================================================== -->
    <section class="home-newsletter section--dark">
      <div class="container container--narrow">
        <div class="home-newsletter__inner animate-fade-in-up">
          <p class="home-newsletter__eyebrow">La carta</p>
          <h2 class="home-newsletter__title">
            Una vez al mes.<br/>Sin ruido. Solo lo que vale la pena.
          </h2>
          <form
            class="home-newsletter__form"
            id="newsletter-form"
            novalidate
          >
            <div class="home-newsletter__field">
              <input
                type="email"
                name="email"
                id="newsletter-email"
                placeholder="tu@email.com"
                required
                autocomplete="email"
                class="home-newsletter__input"
              />
              <button type="submit" class="btn btn--primary home-newsletter__btn">
                Apuntarme
              </button>
            </div>
            <p class="home-newsletter__privacy">
              Sin spam. Baja cuando quieras.
            </p>
            <p class="home-newsletter__feedback" id="newsletter-feedback" aria-live="polite"></p>
          </form>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>

<style>
  /* =====================================================
     HERO
     ===================================================== */

  .home-hero {
    position: relative;
    height: 100svh;
    min-height: 600px;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .home-hero__bg {
    position: absolute;
    inset: 0;
  }

  .home-hero__portrait {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    filter: grayscale(30%) contrast(1.1);
    transform: scale(1.02);
    transition: transform 8s ease;
  }

  .home-hero:hover .home-hero__portrait {
    transform: scale(1.0);
  }

  .home-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      105deg,
      rgba(14, 12, 10, 0.80) 0%,
      rgba(14, 12, 10, 0.50) 50%,
      rgba(14, 12, 10, 0.20) 100%
    );
  }

  .home-hero__content {
    position: relative;
    z-index: 1;
    padding-top: var(--header-height);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    padding-bottom: var(--space-12);
  }

  .home-hero__text {
    max-width: 560px;
    padding-top: var(--space-20);
  }

  .home-hero__eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--blood-light);
    margin-bottom: var(--space-4);
  }

  .home-hero__title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 7vw, 5.5rem);
    font-weight: 300;
    line-height: 1.05;
    color: var(--text-on-dark);
    letter-spacing: -0.01em;
    margin-bottom: var(--space-8);
  }

  .home-hero__title em {
    font-style: italic;
    color: var(--fog-light);
  }

  .home-hero__divider {
    width: 48px;
    height: 1px;
    background-color: var(--blood);
    margin-bottom: var(--space-6);
  }

  .home-hero__sub {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 400;
    letter-spacing: 0.04em;
    color: var(--text-on-dark-muted);
    margin: 0;
  }

  .home-hero__scroll {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-on-dark-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
    align-self: flex-start;
  }

  .home-hero__scroll:hover {
    color: var(--text-on-dark);
  }

  /* =====================================================
     MANIFESTO
     ===================================================== */

  .home-manifesto {
    padding: var(--space-24) 0;
    text-align: center;
  }

  .home-manifesto__text {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 3rem);
    font-style: italic;
    font-weight: 400;
    line-height: 1.5;
    color: var(--text-ink);
    margin-bottom: var(--space-10);
  }

  .home-manifesto__link {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--blood);
    text-decoration: none;
    border-bottom: 1px solid rgba(155, 32, 32, 0.3);
    padding-bottom: 2px;
    transition: border-color var(--transition-fast), color var(--transition-fast);
  }

  .home-manifesto__link:hover {
    color: var(--blood-hover);
    border-color: var(--blood-hover);
  }

  /* =====================================================
     PILLARS
     ===================================================== */

  .home-pillars {
    padding: var(--space-16) 0;
  }

  .home-pillars__heading {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-on-dark-muted);
    margin-bottom: var(--space-8);
  }

  .home-pillars__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background-color: var(--ink-muted);
  }

  .pillar {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    text-decoration: none;
    display: block;
  }

  .pillar__bg {
    position: absolute;
    inset: 0;
    background-image: var(--pillar-image);
    background-size: cover;
    background-position: center;
    filter: grayscale(50%) brightness(0.7);
    transition: filter var(--transition-slow), transform var(--transition-slow);
  }

  .pillar:hover .pillar__bg {
    filter: grayscale(0%) brightness(0.55);
    transform: scale(1.04);
  }

  .pillar__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(14, 12, 10, 0.90) 0%,
      rgba(14, 12, 10, 0.2) 60%,
      transparent 100%
    );
  }

  .pillar__content {
    position: relative;
    z-index: 1;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: var(--space-6);
    gap: var(--space-2);
  }

  .pillar__tagline {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--text-on-dark-muted);
    text-transform: uppercase;
    transition: color var(--transition-base);
  }

  .pillar:hover .pillar__tagline {
    color: var(--blood-light);
  }

  .pillar__label {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 400;
    font-style: italic;
    color: var(--text-on-dark);
    line-height: 1.1;
    margin: 0;
    transition: color var(--transition-base);
  }

  .pillar:hover .pillar__label {
    color: var(--fog-light);
  }

  .pillar__arrow {
    font-size: var(--text-lg);
    color: var(--blood);
    opacity: 0;
    transform: translateX(-8px);
    transition: opacity var(--transition-base), transform var(--transition-base);
  }

  .pillar:hover .pillar__arrow {
    opacity: 1;
    transform: translateX(0);
  }

  /* =====================================================
     RECENT ARTICLES
     ===================================================== */

  .home-articles {
    padding: var(--space-24) 0;
  }

  .home-articles__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: var(--space-12);
    gap: var(--space-4);
  }

  .home-articles__title {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: 400;
    font-style: italic;
    color: var(--text-ink);
    margin: 0;
  }

  .home-articles__all {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--blood);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--transition-fast);
  }

  .home-articles__all:hover {
    color: var(--blood-hover);
  }

  .home-articles__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  /* =====================================================
     NEWSLETTER
     ===================================================== */

  .home-newsletter {
    padding: var(--space-24) 0;
  }

  .home-newsletter__inner {
    text-align: center;
  }

  .home-newsletter__eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--blood-light);
    margin-bottom: var(--space-4);
  }

  .home-newsletter__title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 400;
    font-style: italic;
    color: var(--text-on-dark);
    line-height: 1.35;
    margin-bottom: var(--space-10);
  }

  .home-newsletter__form {
    max-width: 460px;
    margin: 0 auto;
  }

  .home-newsletter__field {
    display: flex;
    gap: 0;
    border: 1px solid rgba(240, 235, 227, 0.2);
    overflow: hidden;
  }

  .home-newsletter__input {
    flex: 1;
    min-width: 0;
    padding: var(--space-4) var(--space-5);
    background-color: rgba(255, 255, 255, 0.06);
    border: none;
    color: var(--text-on-dark);
    font-family: var(--font-body);
    font-size: var(--text-base);
    outline: none;
    transition: background-color var(--transition-fast);
  }

  .home-newsletter__input::placeholder {
    color: var(--text-on-dark-muted);
  }

  .home-newsletter__input:focus {
    background-color: rgba(255, 255, 255, 0.10);
  }

  .home-newsletter__btn {
    border-radius: 0;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .home-newsletter__privacy {
    font-size: var(--text-xs);
    color: var(--text-on-dark-muted);
    margin-top: var(--space-4);
    text-align: center;
  }

  .home-newsletter__feedback {
    font-size: var(--text-sm);
    margin-top: var(--space-3);
    min-height: 1.5em;
    text-align: center;
  }

  /* =====================================================
     RESPONSIVE
     ===================================================== */

  @media (max-width: 1024px) {
    .home-pillars__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .pillar {
      aspect-ratio: 4 / 3;
    }
  }

  @media (max-width: 768px) {
    .home-articles__grid {
      grid-template-columns: 1fr;
    }

    .home-pillars__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .home-manifesto__text {
      font-size: var(--text-3xl);
    }
  }

  @media (max-width: 480px) {
    .home-pillars__grid {
      grid-template-columns: 1fr;
    }

    .pillar {
      aspect-ratio: 16 / 9;
    }
  }
</style>

<script>
  // Newsletter form → /api/subscribe (MailerLite backend)
  const form     = document.getElementById('newsletter-form') as HTMLFormElement | null;
  const feedback = document.getElementById('newsletter-feedback');

  if (form && feedback) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const emailInput = form.querySelector<HTMLInputElement>('[name="email"]');
      if (!emailInput?.value) return;

      const btn = form.querySelector<HTMLButtonElement>('[type="submit"]');
      if (btn) { btn.disabled = true; btn.textContent = 'Enviando...'; }

      try {
        const res = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: emailInput.value }),
        });

        if (res.ok) {
          feedback.style.color = 'var(--blood-light)';
          feedback.textContent = '¡Ya estás dentro! Bienvenido a la comunidad.';
          emailInput.value = '';
        } else {
          feedback.style.color = 'var(--text-on-dark-muted)';
          feedback.textContent = 'Algo salió mal. Inténtalo de nuevo.';
        }
      } catch {
        feedback.style.color = 'var(--text-on-dark-muted)';
        feedback.textContent = 'Error de conexión. Inténtalo de nuevo.';
      } finally {
        if (btn) { btn.disabled = false; btn.textContent = 'Apuntarme'; }
      }
    });
  }
</script>
